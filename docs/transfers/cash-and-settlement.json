  {
    "name": "Add a payment entry to a bank payment order",
    "source": "accounting.payment_entry",
    "destination": "accounting.payment_order",
    "decision": "Append one bank instruction reference for this posted payment. Use its paid amount, supplier, receiving account, party bank account and payment mode. When adding to an existing order keep that order's company. The instruction does not create another payment entry.",
