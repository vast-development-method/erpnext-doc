[
  {
    "name": "Schedule maintenance from a customer invoice",
    "source": "accounting.sales_invoice",
    "destination": "maintenance.maintenance_schedule",
    "decision": "Invoice product rows provide the maintenance lines. The destination owns the service intervals, visit generation and service personnel. Preparing the schedule does not create completed visits.",
    "record_mappings": [
      {
        "source_entity": "accounting.sales_invoice",
        "target_entity": "maintenance.maintenance_schedule",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ]
      },
      {
        "source_entity": "accounting.sales_invoice_item",
        "target_entity": "maintenance.maintenance_schedule_item"
      }
    ]
  },
  {
    "name": "Perform a scheduled maintenance visit",
    "source": "maintenance.maintenance_schedule",
    "destination": "maintenance.maintenance_visit",
    "decision": "Set the service type to scheduled. A selected schedule-detail identifier selects that occurrence, otherwise eligible incompletely visited rows can be proposed. Where one serial is selected use it for the visit purpose. Retain the responsible service person and schedule-detail identity.",
    "record_mappings": [
      {
        "source_entity": "maintenance.maintenance_schedule",
        "target_entity": "maintenance.maintenance_visit",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ],
        "explicit_field_transfers": [
          [
            "record_identifier",
            "maintenance_schedule_identifier"
          ]
        ]
      },
      {
        "source_entity": "maintenance.maintenance_schedule_detail",
        "target_entity": "maintenance.maintenance_visit_purpose",
        "explicit_field_transfers": [
          [
            "sales_person_identifier",
            "service_person_identifier"
          ],
          [
            "record_identifier",
            "maintenance_schedule_detail"
          ]
        ]
      }
    ]
  },
  {
    "name": "Start a timesheet from a project task",
    "source": "projects.task",
    "destination": "projects.timesheet",
    "decision": "Set the parent project from the task and create its time-detail reference. Enter actual working intervals before using any resulting time for costing or billing.",
    "record_mappings": [
      {
        "source_entity": "projects.task",
        "target_entity": "projects.timesheet",
        "explicit_field_transfers": [
          [
            "project_identifier",
            "parent_project_identifier"
          ]
        ]
      },
      {
        "source_entity": "projects.task",
        "target_entity": "projects.timesheet_detail",
        "explicit_field_transfers": [
          [
            "record_identifier",
            "task_identifier"
          ],
          [
            "project_identifier",
            "project_identifier"
          ],
          [
            "actual_time",
            "hours"
          ]
        ]
      }
    ]
  },
  {
    "name": "Open an external project from a sales order",
    "source": "sales.sales_order",
    "destination": "projects.project",
    "decision": "Use the order identity as project name and order reference. Set external project kind. The order's company-currency grand total supplies the initial costing estimate while net sales supplies the initial sales measure. They are different accounting bases.",
    "record_mappings": [
      {
        "source_entity": "sales.sales_order",
        "target_entity": "projects.project",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ],
        "explicit_field_transfers": [
          [
            "record_identifier",
            "sales_order_identifier"
          ],
          [
            "company_currency_grand_total",
            "estimated_costing"
          ],
          [
            "net_total",
            "total_sales_amount"
          ],
          [
            "record_identifier",
            "project_name"
          ]
        ]
      }
    ]
  },
  {
    "name": "Schedule service against a sales order",
    "source": "sales.sales_order",
    "destination": "maintenance.maintenance_schedule",
    "decision": "Create maintenance coverage lines for the order rows. The schedule and its generated visits establish the service dates independently of delivery and billing. A submitted schedule already referring to this order suppresses a second proposal.",
    "record_mappings": [
      {
        "source_entity": "sales.sales_order",
        "target_entity": "maintenance.maintenance_schedule",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ]
      },
      {
        "source_entity": "sales.sales_order_item",
        "target_entity": "maintenance.maintenance_schedule_item",
        "explicit_field_transfers": [
          [
            "owning_record_identifier",
            "sales_order_identifier"
          ]
        ]
      }
    ]
  },
  {
    "name": "Record a service visit from a sales order",
    "source": "sales.sales_order",
    "destination": "maintenance.maintenance_visit",
    "decision": "Select order lines for the visit purposes, retaining their originating order. Set the responsible service person, serials, date and completion state before submitting the visit. A prior submitted, fully completed visit against the order suppresses the new proposal.",
    "record_mappings": [
      {
        "source_entity": "sales.sales_order",
        "target_entity": "maintenance.maintenance_visit",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ]
      },
      {
        "source_entity": "sales.sales_order_item",
        "target_entity": "maintenance.maintenance_visit_purpose",
        "explicit_field_transfers": [
          [
            "owning_record_identifier",
            "prevdoc_record_identifier"
          ],
          [
            "owning_entity_type",
            "prevdoc_entity_type_identifier"
          ]
        ]
      }
    ]
  },
  {
    "name": "Record installation after delivery",
    "source": "inventory.delivery_note",
    "destination": "sales.installation_note",
    "decision": "Propose delivered less returned less installed units, omitting exhausted lines. From an explicit serial list remove returned identities. Submission must recheck the row belongs to the named delivery, is still submitted and agrees on product, customer and company.",
    "calculated_after_mapping": [
      {
        "target_entity": "sales.installation_note_item",
        "target_field": "quantity",
        "rule": "Delivered quantity less returned quantity less installed quantity, measured on the original delivery row."
      }
    ],
    "record_mappings": [
      {
        "source_entity": "inventory.delivery_note",
        "target_entity": "sales.installation_note",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ]
      },
      {
        "source_entity": "inventory.delivery_note_item",
        "target_entity": "sales.installation_note_item",
        "explicit_field_transfers": [
          [
            "record_identifier",
            "prevdoc_detail_record_identifier"
          ],
          [
            "owning_record_identifier",
            "prevdoc_record_identifier"
          ],
          [
            "owning_entity_type",
            "prevdoc_entity_type"
          ]
        ]
      }
    ]
  },
  {
    "name": "Prepare an inspection from a manufacturing recipe",
    "source": "manufacturing.bill_of_materials",
    "destination": "inventory.quality_inspection",
    "decision": "Take the inspected product and recipe reference from the submitted recipe. Assign the active inspector. The inspection records independent measurements and requires its own sample and release decision.",
    "record_mappings": [
      {
        "source_entity": "manufacturing.bill_of_materials",
        "target_entity": "inventory.quality_inspection",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ],
        "explicit_field_transfers": [
          [
            "record_identifier",
            "bill_of_materials_number_identifier"
          ],
          [
            "item_identifier",
            "item_identifier"
          ]
        ]
      }
    ]
  },
  {
    "name": "Plan work for a support issue",
    "source": "customer_support.issue",
    "destination": "projects.task",
    "decision": "Start a project task from the support issue. Its subject can carry forward. Assign scheduling, ownership and time on the task. A task’s progress does not close the issue.",
    "record_mappings": [
      {
        "source_entity": "customer_support.issue",
        "target_entity": "projects.task",
        "explicit_field_transfers": [
          [
            "subject",
            "subject"
          ]
        ]
      }
    ]
  },
  {
    "name": "Perform service against a warranty claim",
    "source": "customer_support.warranty_claim",
    "destination": "maintenance.maintenance_visit",
    "decision": "Suppress a new visit when a submitted, fully completed visit already identifies this claim. Where the claim records a product, add a visit purpose and set its predecessor kind and record identity to the claim. Completing a visit can update resolution and work-performed facts.",
    "record_mappings": [
      {
        "source_entity": "customer_support.warranty_claim",
        "target_entity": "maintenance.maintenance_visit"
      },
      {
        "source_entity": "customer_support.warranty_claim",
        "target_entity": "maintenance.maintenance_visit_purpose",
        "explicit_field_transfers": [
          [
            "record_identifier",
            "prevdoc_record_identifier"
          ],
          [
            "entity_type",
            "prevdoc_entity_type_identifier"
          ]
        ]
      }
    ]
  }
]
