  {
    "name": "Dispatch a customer order",
    "source": "sales.sales_order",
    "destination": "inventory.delivery_note",
    "decision": "Exclude supplier-delivered and otherwise ineligible rows. Subtract delivered quantity and quantities already mapped into the current draft. Unit-price-only rows use a row-identity guard. Where physical reservations govern fulfilment, split the source row by its reserved warehouse and convert reserved stock units back to delivery units.",
    "calculated_after_mapping": [
      {
        "target_entity": "inventory.delivery_note_item",
        "target_field": "quantity",
        "rule": "For an ordinary line, ordered quantity less delivered quantity less units already mapped from the same source row into the destination."
      },
      {
        "target_entity": "inventory.delivery_note_item",
        "target_field": "company_currency_amount",
        "rule": "Remaining units × order row company-currency rate. For a reservation-specific split, re-evaluate the split quantity in its transaction unit."
      }
    ],
    "record_mappings": [
      {
        "source_entity": "sales.sales_order",
        "target_entity": "inventory.delivery_note",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ]
      },
      {
        "source_entity": "accounting.sales_taxes_and_charges",
        "target_entity": "accounting.sales_taxes_and_charges",
        "collection_policy": "Reset destination collection before copying selected source rows."
      },
      {
        "source_entity": "sales.sales_team",
        "target_entity": "sales.sales_team",
        "collection_policy": "Only add rows when the destination collection is empty."
      },
      {
        "source_entity": "sales.sales_order_item",
        "target_entity": "inventory.delivery_note_item",
        "explicit_field_transfers": [
          [
            "rate",
            "rate"
          ],
          [
            "record_identifier",
            "sales_order_line"
          ],
          [
            "owning_record_identifier",
            "against_sales_order_identifier"
          ]
        ]
      }
    ]
  },
  {
    "name": "Bill a customer order",
    "source": "sales.sales_order",
    "destination": "accounting.sales_invoice",
    "decision": "Use the order line's effective returns, delivered units, invoiced quantity, currently mapped quantity and amount tolerance. A quantity-complete but monetarily underbilled row may qualify. Resolve the customer's receivable account, deferred revenue applicability and cost centre. Preserve the difference between a unit-price-only row and a fully billed ordinary row.",
    "calculated_after_mapping": [
      {
        "target_entity": "accounting.sales_invoice_item",
        "target_field": "company_currency_amount",
        "rule": "Proposed billable transaction amount × source order exchange rate."
      },
      {
        "target_entity": "accounting.sales_invoice_item",
        "target_field": "amount",
        "rule": "When billing by outstanding value, original row amount less effective billed amount."
      }
    ],
    "record_mappings": [
      {
        "source_entity": "sales.sales_order",
        "target_entity": "accounting.sales_invoice",
        "source_requirements": [
          [
            "lifecycle_state",
