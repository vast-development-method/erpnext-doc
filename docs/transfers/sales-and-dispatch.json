[
  {
    "name": "Dispatch stock from a customer invoice",
    "source": "accounting.sales_invoice",
    "destination": "inventory.delivery_note",
    "decision": "Select rows with invoiced quantity above delivered quantity. Exclude supplier-delivered rows, inward-subcontract rows and rows already referring to a delivery line. Calculate remaining stock units as remaining invoice units times conversion factor. Calculate transaction and company amounts with their respective rates.",
    "calculated_after_mapping": [
      {
        "target_entity": "inventory.delivery_note_item",
        "target_field": "quantity",
        "rule": "Invoiced quantity less delivered quantity."
      },
      {
        "target_entity": "inventory.delivery_note_item",
        "target_field": "stock_quantity",
        "rule": "Remaining invoice quantity × invoice row conversion factor."
      },
      {
        "target_entity": "inventory.delivery_note_item",
        "target_field": "company_currency_amount",
        "rule": "Remaining invoice quantity × company-currency invoice unit rate."
      }
    ],
    "record_mappings": [
      {
        "source_entity": "accounting.sales_invoice",
        "target_entity": "inventory.delivery_note",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ]
      },
      {
        "source_entity": "accounting.sales_invoice_item",
        "target_entity": "inventory.delivery_note_item",
        "explicit_field_transfers": [
          [
            "record_identifier",
            "sales_invoice_line"
          ],
