  {
    "name": "Order a supplier quotation",
    "source": "procurement.supplier_quotation",
    "destination": "procurement.purchase_order",
    "decision": "A selected ordinary row contributes the open quantity remaining to order. A unit-price row with zero quoted quantity can also qualify. Exclude a row already mapped into the target. Cap proposed order quantity below at zero and extend it by the source conversion factor for stock quantity. The purchase order has its own transaction date.",
    "calculated_after_mapping": [
      {
        "target_entity": "procurement.purchase_order_item",
        "target_field": "quantity",
        "rule": "Maximum of outstanding quoted quantity and zero."
      },
      {
        "target_entity": "procurement.purchase_order_item",
        "target_field": "stock_quantity",
        "rule": "New order quantity × original quotation unit factor."
      }
    ],
    "record_mappings": [
      {
        "source_entity": "procurement.supplier_quotation",
        "target_entity": "procurement.purchase_order",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ]
        ],
        "excluded_from_default_copy": [
          "transaction_date"
        ]
      },
      {
        "source_entity": "procurement.supplier_quotation_item",
        "target_entity": "procurement.purchase_order_item",
        "explicit_field_transfers": [
          [
            "record_identifier",
            "supplier_quotation_item_identifier"
          ],
          [
            "owning_record_identifier",
            "supplier_quotation_identifier"
          ],
          [
            "material_request_identifier",
            "material_request_identifier"
          ],
          [
            "material_request_item",
            "material_request_item"
          ],
          [
            "sales_order_identifier",
            "sales_order_identifier"
          ]
        ]
      },
      {
        "source_entity": "accounting.purchase_taxes_and_charges",
        "target_entity": "accounting.purchase_taxes_and_charges",
        "collection_policy": "Reset destination collection before copying selected source rows."
      }
    ]
  },
