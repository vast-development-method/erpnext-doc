        "source_entity": "accounting.purchase_taxes_and_charges",
        "target_entity": "accounting.purchase_taxes_and_charges",
        "collection_policy": "Reset destination collection before copying selected source rows."
      }
    ]
  },
  {
    "name": "Execute an authorised material request",
    "source": "inventory.material_request",
    "destination": "inventory.stock_entry",
    "decision": "Accept transfer, issue or customer-provided requests with open stock quantity. A transfer uses the source and destination, an issue uses the issuing warehouse and customer-provided stock creates a receipt with zero valuation permitted. A work-order or operation-card transfer carries the production purpose and its recipe context.",
    "record_mappings": [
      {
        "source_entity": "inventory.material_request",
        "target_entity": "inventory.stock_entry",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ],
          [
            "material_request_type",
            "one of",
            [
              "Material Transfer",
              "Material Issue",
              "Customer Provided"
            ]
          ]
        ]
      },
      {
        "source_entity": "inventory.material_request_item",
        "target_entity": "inventory.stock_entry_detail",
        "explicit_field_transfers": [
          [
            "record_identifier",
            "material_request_item_identifier"
          ],
          [
            "owning_record_identifier",
            "material_request_identifier"
          ],
          [
            "unit_of_measure_identifier",
            "stock_unit_of_measure_identifier"
          ],
          [
            "job_card_item",
            "job_card_item"
          ]
        ],
        "excluded_from_default_copy": [
          "expense_account_identifier"
        ]
      }
    ]
  },
  {
    "name": "Pick a material transfer request",
    "source": "inventory.material_request",
    "destination": "inventory.pick_list",
    "decision": "Require a submitted transfer request. Map still-unpicked stock quantity at row precision. Use the request's source warehouse as the pick warehouse and retain the request row so another pick can only consume its remaining demand.",
