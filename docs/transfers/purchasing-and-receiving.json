  {
    "name": "Complete the receiving leg of transit stock",
    "source": "inventory.stock_entry",
    "destination": "inventory.stock_entry",
    "decision": "Require a submitted transfer to transit. Compute remaining transferred stock quantity at row precision. Divide by the original conversion factor to get receiving units. Set the transit location as the source, the chosen destination as the target, and clear the instruction to place this leg into transit again.",
    "identity": "Create a distinct target record.",
    "calculated_after_mapping": [
      {
        "target_entity": "inventory.stock_entry_detail",
        "target_field": "quantity",
        "rule": "Remaining transferable stock units divided by the original transaction-to-stock unit factor. Skip fully received transit movements."
      }
    ],
    "record_mappings": [
      {
        "source_entity": "inventory.stock_entry",
        "target_entity": "inventory.stock_entry",
        "source_requirements": [
          [
            "lifecycle_state",
            "equals",
            "posted"
          ],
          [
            "purpose",
            "equals",
            "Material Transfer"
          ],
          [
            "add_to_transit",
            "equals",
            1
          ]
        ],
        "explicit_field_transfers": [
          [
            "record_identifier",
            "outgoing_stock_entry_identifier"
          ]
        ]
      },
      {
        "source_entity": "inventory.stock_entry_detail",
        "target_entity": "inventory.stock_entry_detail",
        "explicit_field_transfers": [
          [
            "record_identifier",
            "ste_detail"
          ],
          [
            "owning_record_identifier",
            "related_stock_movement_identifier"
          ],
          [
            "serial_number",
            "serial_number"
          ],
          [
            "batch_number_identifier",
            "batch_number_identifier"
          ],
          [
            "target_warehouse_identifier",
            "source_warehouse_identifier"
          ]
        ]
      }
    ]
  }
