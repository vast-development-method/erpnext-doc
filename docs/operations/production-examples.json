  {
    "operation": "Distribute material demand across substitutes",
    "examples": [
      {
        "inputs": {
          "demand": 3,
          "materials": [
            {
              "available": 4,
              "transferred": 8
            },
            {
              "available": 2,
              "transferred": 8
            }
          ],
          "precision": 2
        },
        "expected": {
          "row_quantities": [
            2,
            1
          ]
        }
      },
      {
        "inputs": {
          "demand": 10,
          "materials": [
            {
              "available": 0,
              "transferred": 1
            },
            {
              "available": -1,
              "transferred": 3
            }
          ],
          "precision": 2
        },
        "expected": {
          "row_quantities": [
            2.5,
            7.5
          ]
        }
      },
      {
        "inputs": {
          "demand": 1,
          "materials": [
            {
              "available": 1,
              "transferred": 1
            },
            {
              "available": 1,
              "transferred": 1
            },
            {
              "available": 1,
              "transferred": 1
            }
          ],
          "precision": 2
        },
        "expected": {
          "row_quantities": [
            0.33,
            0.33,
            0.34
          ]
        }
      },
      {
        "inputs": {
          "demand": 2,
          "materials": [
            {
              "available": 0,
              "transferred": 0
            },
            {
              "available": 0,
              "transferred": 0
            }
          ],
          "precision": 2
        },
        "expected": {
          "row_quantities": [
            0,
            0
          ]
        }
      }
    ]
  },
  {
    "operation": "Calculate cumulative component recovery",
    "examples": [
      {
        "inputs": {
          "original_component_quantity": 5,
          "finished_to_date": 1,
          "finished_total": 3,
          "already_recovered": 0,
          "whole_unit_step": 1,
          "precision": 6
        },
        "expected": {
          "recover": 1
        }
      },
      {
        "inputs": {
          "original_component_quantity": 5,
          "finished_to_date": 2,
          "finished_total": 3,
          "already_recovered": 1,
          "whole_unit_step": 1,
          "precision": 6
        },
        "expected": {
          "recover": 2
        }
      },
      {
        "inputs": {
          "original_component_quantity": 5,
          "finished_to_date": 3,
          "finished_total": 3,
          "already_recovered": 3,
          "whole_unit_step": 1,
          "precision": 6
        },
        "expected": {
          "recover": 2
        }
      },
      {
        "inputs": {
          "original_component_quantity": 1,
          "finished_to_date": 1,
          "finished_total": 4,
          "already_recovered": 0,
          "whole_unit_step": null,
          "precision": 3
        },
        "expected": {
          "recover": 0.25
        }
      }
    ]
  },
  {
    "operation": "Determine the lifecycle state of a material reservation",
    "examples": [
      {
        "inputs": {
          "reservation_document_state": "draft",
          "document_demand_quantity": 10,
          "reserved": 8,
          "transferred": 0,
          "delivered": 0,
          "consumed": 0
