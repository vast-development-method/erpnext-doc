      },
      {
        "inputs": {
          "reservation_document_state": "cancelled",
          "document_demand_quantity": 10,
          "reserved": 8,
          "transferred": 8,
          "delivered": 0,
          "consumed": 0
        },
        "expected": {
          "status": "Cancelled"
        }
      },
      {
        "inputs": {
          "reservation_document_state": "submitted",
          "document_demand_quantity": 10,
          "reserved": 8,
          "transferred": 3,
          "delivered": 7,
          "consumed": 1
        },
        "expected": {
          "status": "Partially Used"
        }
      },
      {
        "inputs": {
          "reservation_document_state": "submitted",
          "document_demand_quantity": 10,
          "reserved": 8,
          "transferred": 8,
          "delivered": 0,
          "consumed": 0
        },
        "expected": {
          "status": "Closed"
        }
      },
      {
        "inputs": {
          "reservation_document_state": "submitted",
          "document_demand_quantity": 10,
          "reserved": 8,
          "transferred": 0,
          "delivered": 5,
          "consumed": 3
        },
        "expected": {
          "status": "Delivered"
        }
      },
      {
        "inputs": {
          "reservation_document_state": "submitted",
          "document_demand_quantity": 10,
          "reserved": 8,
          "transferred": 0,
          "delivered": 4,
          "consumed": 2
        },
        "expected": {
          "status": "Partially Delivered"
        }
      },
      {
        "inputs": {
          "reservation_document_state": "submitted",
          "document_demand_quantity": 10,
          "reserved": 8,
          "transferred": 0,
          "delivered": 0,
          "consumed": 3
        },
        "expected": {
          "status": "Partially Used"
        }
      },
      {
        "inputs": {
          "reservation_document_state": "submitted",
          "document_demand_quantity": 10,
          "reserved": 10,
          "transferred": 0,
          "delivered": 0,
          "consumed": 0
        },
        "expected": {
          "status": "Reserved"
        }
      },
      {
        "inputs": {
          "reservation_document_state": "submitted",
