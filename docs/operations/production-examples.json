  {
    "operation": "Convert operation loss to finished units",
    "examples": [
      {
        "inputs": {
          "work_order_quantity": 10,
          "operation_quantity": 50,
          "operation_loss": 5,
          "precision": 3
        },
        "expected": {
          "loss_in_finished_units": 1
        }
      },
      {
        "inputs": {
          "work_order_quantity": 10,
          "operation_quantity": 4,
          "operation_loss": 1,
          "precision": 3
        },
        "expected": {
          "loss_in_finished_units": 2.5
        }
      },
      {
        "inputs": {
          "work_order_quantity": 10,
          "operation_quantity": 0,
          "operation_loss": 2,
          "precision": 3
        },
        "expected": {
          "loss_in_finished_units": 0
        }
      }
    ]
  },
