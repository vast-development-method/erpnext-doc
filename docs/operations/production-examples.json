        }
      },
      {
        "inputs": {
          "logs": [
            {
              "start_minute": 480,
              "end_minute": null,
              "duration_minutes": 15
            },
            {
              "start_minute": 495,
              "end_minute": 540,
              "duration_minutes": 0
            },
            {
              "start_minute": null,
              "end_minute": null,
              "duration_minutes": 10
            }
          ]
        },
        "expected": {
          "occupied_machine_minutes": 70
        }
      },
      {
        "inputs": {
          "logs": [
            {
              "start_minute": 480,
              "end_minute": 495,
              "duration_minutes": 0
            },
            {
              "start_minute": 525,
