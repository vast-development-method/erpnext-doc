  {
    "operation": "Split a whole-unit forecast among actual demands",
    "examples": [
      {
        "inputs": {
          "actual": [
            3,
            2
          ],
          "forecast": 7
        },
        "expected": {
          "shares": [
            4,
            3
          ],
          "demand": [
            4,
            3
          ]
        }
      },
      {
        "inputs": {
          "actual": [
            1,
            1,
            1
          ],
          "forecast": 2
        },
        "expected": {
          "shares": [
            1,
            1,
            0
          ],
          "demand": [
            1,
            1,
            1
          ]
        }
      },
      {
        "inputs": {
          "actual": [
            0,
            0
          ],
          "forecast": 4
        },
        "expected": {
          "shares": [
            4,
            0
          ],
          "demand": [
            4,
            0
          ]
        }
      }
    ]
  },
