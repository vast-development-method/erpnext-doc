{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketplace source inspection rows",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "enum": [
          "declared_erpnext",
          "source_erpnext_import",
          "erpnext_record_hook",
          "erpnext_record_operation",
          "erpnext_record_customization",
          "erpnext_record_link",
          "test_erpnext_import",
          "no-detected-erpnext-reference",
          "curated-extension",
          "core-profile",
          "no-repository",
          "no-immutable-revision",
          "compressed-size-limit",
          "archive-unavailable",
          "archive-limit",
          "unreadable-archive"
        ]
      },
      "repository": {
        "type": "string"
      },
      "revision": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      },
      "archive_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "evidence": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "declared_erpnext",
            "source_erpnext_import",
            "erpnext_record_hook",
            "erpnext_record_operation",
            "erpnext_record_customization",
            "erpnext_record_link",
            "test_erpnext_import"
          ]
        },
        "additionalProperties": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string"
            }
          ],
          "items": false,
          "minItems": 3
        }
      },
      "scan": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "files",
            "expanded_bytes",
            "selected_files",
            "parsed_python"
          ]
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      },
      "unparsed": {
        "type": "array",
        "items": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "items": false,
          "minItems": 2
        }
      },
      "declarations": {
        "type": "object",
        "propertyNames": {
          "enum": [
            "record-operation",
            "custom-field",
            "property-rule",
            "custom-permission",
            "module",
            "record",
            "field",
            "permission",
            "hook",
            "service",
            "test",
            "test-file",
            "report",
            "view"
          ]
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "required": [
      "id",
      "status"
    ],
    "additionalProperties": false,
    "dependentRequired": {
      "archive_sha256": [
        "revision",
        "repository",
        "evidence",
        "scan",
        "declarations"
      ]
    }
  }
}
