{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketplace semantic inventory manifest",
  "type": "object",
  "properties": {
    "source_date": {
      "type": "string",
      "format": "date"
    },
    "listing_count": {
      "type": "integer",
      "minimum": 0
    },
    "status_counts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "declared_erpnext",
          "source_erpnext_import",
          "erpnext_record_hook",
          "erpnext_record_operation",
          "erpnext_record_customization",
          "erpnext_record_link",
          "test_erpnext_import",
          "no-detected-erpnext-reference",
          "curated-extension",
          "core-profile",
          "no-repository",
          "no-immutable-revision",
          "compressed-size-limit",
          "archive-unavailable",
          "archive-limit",
          "unreadable-archive"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "surface_counts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "record-operation",
          "custom-field",
          "property-rule",
          "custom-permission",
          "module",
          "record",
          "field",
          "permission",
          "hook",
          "service",
          "test",
          "test-file",
          "report",
          "view"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "surface_tuple": {
      "const": [
        "listing_id",
        "kind",
        "repository_relative_path",
        "entries"
      ]
    },
    "entry_columns": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "record-operation",
          "custom-field",
          "property-rule",
          "custom-permission",
          "module",
          "record",
          "field",
          "permission",
          "hook",
          "service",
          "test",
          "test-file",
          "report",
          "view"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "required": [
        "record-operation",
        "custom-field",
        "property-rule",
        "custom-permission",
        "module",
        "record",
        "field",
        "permission",
        "hook",
        "service",
        "test",
        "test-file",
        "report",
        "view"
      ]
    },
    "class_precedence": {
      "const": [
        "declared_erpnext",
        "source_erpnext_import",
        "erpnext_record_hook",
        "erpnext_record_operation",
        "erpnext_record_customization",
        "erpnext_record_link",
        "test_erpnext_import"
      ]
    },
    "directory": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shards_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "source_date",
    "listing_count",
    "status_counts",
    "surface_counts",
    "surface_tuple",
    "entry_columns",
    "class_precedence",
    "directory",
    "surfaces",
    "shards_sha256"
  ],
  "additionalProperties": false
}
