{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parent and subsidiary currency-translation acceptance cases",
  "type": "object",
  "properties": {
    "revision": {
      "const": "886ab6ae187244e7f1b852393384ab6019d56264"
    },
    "minor_units_per_major": {
      "const": 100
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parent_sale_nad": {
            "type": "integer",
            "minimum": 0
          },
          "child_sale_usd": {
            "type": "integer",
            "minimum": 0
          },
          "closing_nad_per_usd": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$"
          },
          "posting_nad_per_usd": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(\\.[0-9]+)?$"
          },
          "child_income_in_reporting_nad": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "accumulate_subsidiaries": {
            "type": "boolean"
          },
          "expected_parent_nad": {
            "type": "object",
            "properties": {
              "cash": {
                "type": "integer",
                "minimum": 0
              },
              "profit": {
                "type": "integer",
                "minimum": 0
              },
              "equity_translation_reserve_credit": {
                "type": "integer"
              }
            },
            "required": [
              "cash",
              "profit",
              "equity_translation_reserve_credit"
            ],
            "additionalProperties": false
          },
          "expected_child_usd": {
            "type": "object",
            "properties": {
              "cash": {
                "type": "integer",
                "minimum": 0
              },
              "profit": {
                "type": "integer",
                "minimum": 0
              },
              "equity_translation_reserve_credit": {
                "type": "integer"
              }
            },
            "required": [
              "cash",
              "profit",
              "equity_translation_reserve_credit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "parent_sale_nad",
          "child_sale_usd",
          "closing_nad_per_usd",
          "posting_nad_per_usd",
          "child_income_in_reporting_nad",
          "accumulate_subsidiaries",
          "expected_parent_nad",
          "expected_child_usd"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "revision",
    "minor_units_per_major",
    "cases"
  ],
  "additionalProperties": false
}
