{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "const": "FIFO-linked-delivery-v1"
    },
    "currency": {
      "const": "NAD"
    },
    "amount_scale": {
      "const": 2
    },
    "tax_percent": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "enum": [
              "open",
              "receive",
              "supplier_bill",
              "repack",
              "deliver",
              "invoice",
              "collect",
              "return_delivery",
              "credit",
              "pay_supplier"
            ]
          },
          "inputs": {
            "type": "object"
          },
          "predecessors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "journal_net_debit": {
            "type": "object",
            "minProperties": 2,
            "propertyNames": {
              "enum": [
                "bank",
                "capital",
                "cost_of_sales",
                "input_tax",
                "output_tax",
                "packed_inventory",
                "payables",
                "raw_inventory",
                "receipt_clearing",
                "receivables",
                "sales"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
            }
          },
          "stock": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item": {
                  "enum": [
                    "raw",
                    "packed"
                  ]
                },
                "quantity_delta": {
                  "type": "integer"
                },
                "value_delta": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
                }
              },
              "required": [
                "item",
                "quantity_delta",
                "value_delta"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "operation",
          "inputs",
          "predecessors",
          "journal_net_debit",
          "stock"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "open"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "cash": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
                    }
                  },
                  "required": [
                    "cash"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "receive"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "units": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "purchase_rate": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
                    }
                  },
                  "required": [
                    "units",
                    "purchase_rate"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "supplier_bill"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "receipts": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "receipts"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "repack"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "raw_units": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "finished_units": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "raw_units",
                    "finished_units"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "deliver"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "units": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "units"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "invoice"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "shipment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit_price": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
                    }
                  },
                  "required": [
                    "shipment",
                    "unit_price"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "collect"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "invoice": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
                    }
                  },
                  "required": [
                    "invoice",
                    "amount"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "return_delivery"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "shipment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "units": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "shipment",
                    "units"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "credit"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "invoice": {
                      "type": "string",
                      "minLength": 1
                    },
                    "return_delivery": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "invoice",
                    "return_delivery"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "pay_supplier"
                }
              }
            },
            "then": {
              "properties": {
                "inputs": {
                  "type": "object",
                  "properties": {
                    "bill": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
                    }
                  },
                  "required": [
                    "bill",
                    "amount"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "closing": {
      "type": "object",
      "properties": {
        "bank": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "raw_quantity": {
          "type": "integer"
        },
        "raw_value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "packed_quantity": {
          "type": "integer"
        },
        "packed_value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "unbilled_receipts": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "customer_outstanding": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "supplier_outstanding": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "net_sales": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "cost_of_sales": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "gross_profit": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "input_tax": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "output_tax": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "assets": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        },
        "liabilities_and_equity": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)[.][0-9]{2}$"
        }
      },
      "required": [
        "bank",
        "raw_quantity",
        "raw_value",
        "packed_quantity",
        "packed_value",
        "unbilled_receipts",
        "customer_outstanding",
        "supplier_outstanding",
        "net_sales",
        "cost_of_sales",
        "gross_profit",
        "input_tax",
        "output_tax",
        "assets",
        "liabilities_and_equity"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "currency",
    "amount_scale",
    "tax_percent",
    "steps",
    "closing"
  ],
  "additionalProperties": false
}
