{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observed live recovery contract",
  "type": "object",
  "properties": {
    "outcome": {
      "const": "passed"
    },
    "versions": {
      "type": "object",
      "properties": {
        "erpnext": {
          "type": "string",
          "minLength": 1
        },
        "frappe": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "erpnext",
        "frappe",
        "database"
      ],
      "additionalProperties": false
    },
    "archive_bytes": {
      "type": "object",
      "properties": {
        "database": {
          "type": "integer",
          "minimum": 1
        },
        "public_files": {
          "type": "integer",
          "minimum": 1
        },
        "private_files": {
          "type": "integer",
          "minimum": 1
        },
        "site_config": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "database",
        "public_files",
        "private_files",
        "site_config"
      ],
      "additionalProperties": false
    },
    "restored_document": {
      "const": "Committed before backup"
    },
    "source_after_restore": {
      "const": "Committed after backup"
    },
    "distinct_site_databases": {
      "const": true
    },
    "fresh_target_connection": {
      "const": true
    },
    "attachments": {
      "type": "object",
      "properties": {
        "public": {
          "type": "object",
          "properties": {
            "same_file_id": {
              "const": true
            },
            "same_parent": {
              "const": true
            },
            "same_url_and_privacy": {
              "const": true
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "same_file_id",
            "same_parent",
            "same_url_and_privacy",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "private": {
          "type": "object",
          "properties": {
            "same_file_id": {
              "const": true
            },
            "same_parent": {
              "const": true
            },
            "same_url_and_privacy": {
              "const": true
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "same_file_id",
            "same_parent",
            "same_url_and_privacy",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "public",
        "private"
      ],
      "additionalProperties": false
    },
    "private_download_status": {
      "type": "object",
      "properties": {
        "administrator": {
          "const": 200
        },
        "guest": {
          "const": 403
        },
        "unrelated_website_user": {
          "const": 403
        }
      },
      "required": [
        "administrator",
        "guest",
        "unrelated_website_user"
      ],
      "additionalProperties": false
    },
    "last_number_at_backup": {
      "const": "0002"
    },
    "source_next_number": {
      "const": "0003"
    },
    "restored_next_number": {
      "const": "0003"
    }
  },
  "required": [
    "outcome",
    "versions",
    "archive_bytes",
    "restored_document",
    "source_after_restore",
    "distinct_site_databases",
    "fresh_target_connection",
    "attachments",
    "private_download_status",
    "last_number_at_backup",
    "source_next_number",
    "restored_next_number"
  ],
  "additionalProperties": false
}
