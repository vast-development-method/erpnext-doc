{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "baseline",
    "stages",
    "annotations"
  ],
  "properties": {
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "object",
      "required": [
        "inventoried",
        "reviewed",
        "isolated-function",
        "live"
      ],
      "properties": {
        "inventoried": {
          "type": "string",
          "minLength": 1
        },
        "reviewed": {
          "type": "string",
          "minLength": 1
        },
        "isolated-function": {
          "type": "string",
          "minLength": 1
        },
        "live": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project",
          "surface",
          "path",
          "line",
          "stage",
          "scope",
          "evidence"
        ],
        "properties": {
          "project": {
            "enum": [
              "erpnext",
              "frappe"
            ]
          },
          "surface": {
            "enum": [
              "client-test-declarations",
              "client-test-suites",
              "event-dispatch",
              "form-handlers",
              "hooks",
              "lifecycle",
              "reports",
              "routes",
              "rpc",
              "schedules",
              "server-tests",
              "website-assets"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "enum": [
              "inventoried",
              "reviewed",
              "isolated-function",
              "live"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
