{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "sources",
    "counts",
    "shards"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "sources": {
      "type": "object",
      "required": [
        "erpnext",
        "frappe"
      ],
      "properties": {
        "erpnext": {
          "type": "object",
          "required": [
            "base",
            "revision",
            "trackedPaths",
            "serverModules",
            "jsonPaths"
          ],
          "properties": {
            "base": {
              "type": "string",
              "pattern": "^https://github[.]com/frappe/"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "trackedPaths": {
              "type": "integer",
              "minimum": 1
            },
            "serverModules": {
              "type": "integer",
              "minimum": 1
            },
            "jsonPaths": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "frappe": {
          "type": "object",
          "required": [
            "base",
            "revision",
            "trackedPaths",
            "serverModules",
            "jsonPaths"
          ],
          "properties": {
            "base": {
              "type": "string",
              "pattern": "^https://github[.]com/frappe/"
            },
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "trackedPaths": {
              "type": "integer",
              "minimum": 1
            },
            "serverModules": {
              "type": "integer",
              "minimum": 1
            },
            "jsonPaths": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": [
        "erpnext",
        "frappe"
      ],
      "properties": {
        "erpnext": {
          "type": "object",
          "required": [
            "client-test-declarations",
            "client-test-suites",
            "event-dispatch",
            "form-handlers",
            "hooks",
            "lifecycle",
            "reports",
            "rpc",
            "schedules",
            "server-tests",
            "website-assets"
          ],
          "properties": {
            "client-test-declarations": {
              "type": "integer",
              "minimum": 1
            },
            "client-test-suites": {
              "type": "integer",
              "minimum": 1
            },
            "event-dispatch": {
              "type": "integer",
              "minimum": 1
            },
            "form-handlers": {
              "type": "integer",
              "minimum": 1
            },
            "hooks": {
              "type": "integer",
              "minimum": 1
            },
            "lifecycle": {
              "type": "integer",
              "minimum": 1
            },
            "reports": {
              "type": "integer",
              "minimum": 1
            },
            "rpc": {
              "type": "integer",
              "minimum": 1
            },
            "schedules": {
              "type": "integer",
              "minimum": 1
            },
            "server-tests": {
              "type": "integer",
              "minimum": 1
            },
            "website-assets": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "frappe": {
          "type": "object",
          "required": [
            "client-test-declarations",
            "client-test-suites",
            "event-dispatch",
            "form-handlers",
            "hooks",
            "lifecycle",
            "reports",
            "routes",
            "rpc",
            "schedules",
            "server-tests",
            "website-assets"
          ],
          "properties": {
            "client-test-declarations": {
              "type": "integer",
              "minimum": 1
            },
            "client-test-suites": {
              "type": "integer",
              "minimum": 1
            },
            "event-dispatch": {
              "type": "integer",
              "minimum": 1
            },
            "form-handlers": {
              "type": "integer",
              "minimum": 1
            },
            "hooks": {
              "type": "integer",
              "minimum": 1
            },
            "lifecycle": {
              "type": "integer",
              "minimum": 1
            },
            "reports": {
              "type": "integer",
              "minimum": 1
            },
            "routes": {
              "type": "integer",
              "minimum": 1
            },
            "rpc": {
              "type": "integer",
              "minimum": 1
            },
            "schedules": {
              "type": "integer",
              "minimum": 1
            },
            "server-tests": {
              "type": "integer",
              "minimum": 1
            },
            "website-assets": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "records",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^shards/[a-z-]+-[0-9]{3}[.]json$"
          },
          "records": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
