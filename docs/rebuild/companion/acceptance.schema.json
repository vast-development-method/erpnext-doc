{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Companion decision vectors",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "const": "helpdesk.sync_status"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "erp_installed": {
                "type": "boolean"
              },
              "erp_customer_read": {
                "type": "boolean"
              },
              "hd_customer_read": {
                "type": "boolean"
              },
              "setting": {
                "type": "boolean"
              },
              "all_linked": {
                "type": "boolean"
              }
            },
            "required": [
              "erp_installed",
              "erp_customer_read",
              "hd_customer_read",
              "setting",
              "all_linked"
            ]
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "in_sync": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled",
                  "in_sync"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "const": false
                  }
                },
                "required": [
                  "enabled"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "operation",
          "input",
          "expected"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "const": "insights.widens"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "before": {
                "type": "string",
                "minLength": 1
              },
              "before_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "after": {
                "type": "string",
                "minLength": 1
              },
              "after_roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "before",
              "before_roles",
              "after",
              "after_roles"
            ]
          },
          "expected": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "operation",
          "input",
          "expected"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "const": "drive.entity_kind"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "team": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "content_doctype": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "team",
              "content_doctype"
            ]
          },
          "expected": {
            "enum": [
              "readonly",
              "native"
            ]
          }
        },
        "required": [
          "id",
          "operation",
          "input",
          "expected"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "const": "print.template"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "designer": {
                "type": "boolean"
              },
              "has_body": {
                "type": "boolean"
              },
              "schema_version": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "designer",
              "has_body",
              "schema_version"
            ]
          },
          "expected": {
            "enum": [
              "default",
              "old_print_format",
              "print_format"
            ]
          }
        },
        "required": [
          "id",
          "operation",
          "input",
          "expected"
        ]
      },
      {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "const": "lms.verify_charge"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "paid_minor": {
                "type": "integer",
                "minimum": 0
              },
              "paid_currency": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "receipt": {
                "type": "string",
                "minLength": 1
              },
              "payment": {
                "type": "string",
                "minLength": 1
              },
              "base": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              },
              "including_gst": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              },
              "expected_currency": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "paid_minor",
              "paid_currency",
              "status",
              "receipt",
              "payment",
              "base",
              "including_gst",
              "expected_currency"
            ]
          },
          "expected": {
            "enum": [
              "status",
              "currency",
              "receipt",
              "amount",
              "accepted"
            ]
          }
        },
        "required": [
          "id",
          "operation",
          "input",
          "expected"
        ]
      }
    ]
  }
}
