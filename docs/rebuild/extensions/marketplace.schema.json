{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketplace listing snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "observation_date": {
      "type": "string",
      "format": "date"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "listing_page_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listings": {
          "type": "integer",
          "minimum": 0
        },
        "supported_major_16_listed": {
          "type": "integer",
          "minimum": 0
        },
        "default_heads_resolved": {
          "type": "integer",
          "minimum": 0
        },
        "named_source_confirmed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "listings",
        "supported_major_16_listed",
        "default_heads_resolved",
        "named_source_confirmed"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "listings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "listing_url": {
            "type": "string",
            "format": "uri"
          },
          "listed_versions": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "repository_url": {
            "type": "string",
            "format": "uri"
          },
          "source_basis": {
            "enum": [
              "github_resource",
              "repository_resource_candidate"
            ]
          },
          "default_branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "head_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "head_status": {
            "const": "unresolved"
          },
          "curated_profile": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "publisher",
          "listing_url",
          "listed_versions",
          "repository_url",
          "source_basis"
        ],
        "oneOf": [
          {
            "required": [
              "head_commit",
              "default_branch"
            ]
          },
          {
            "required": [
              "head_status"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "observation_date",
    "source_url",
    "listing_page_sha256",
    "counts",
    "scope",
    "listings"
  ]
}
