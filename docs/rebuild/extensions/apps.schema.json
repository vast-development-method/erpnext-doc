{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated source profile manifest",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "repository": {
        "type": "string",
        "minLength": 1
      },
      "ref": {
        "type": "string",
        "minLength": 1
      },
      "commit": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      },
      "module_path": {
        "type": [
          "string",
          "null"
        ]
      },
      "modules": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "hooks_path": {
        "type": "string",
        "minLength": 1
      },
      "declared_dependencies": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "review": {
        "type": "string",
        "minLength": 1
      },
      "counts": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_declarations": {
            "type": "integer",
            "minimum": 0
          },
          "field_declarations": {
            "type": "integer",
            "minimum": 0
          },
          "reports": {
            "type": "integer",
            "minimum": 0
          },
          "exposed_operations": {
            "type": "integer",
            "minimum": 0
          },
          "hook_assignments": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "record_declarations",
          "field_declarations",
          "reports",
          "exposed_operations",
          "hook_assignments"
        ]
      },
      "catalogs": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hooks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "records",
          "operations",
          "reports",
          "hooks"
        ]
      },
      "license_paths": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "required": [
      "id",
      "repository",
      "ref",
      "commit",
      "module_path",
      "modules",
      "hooks_path",
      "declared_dependencies",
      "review",
      "counts",
      "catalogs",
      "license_paths"
    ]
  }
}
