{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integration qualification scenarios",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "chapter",
      "operation",
      "given",
      "command",
      "read_back",
      "expect",
      "qualification",
      "evidence"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "chapter": {
        "type": "string",
        "minLength": 1
      },
      "operation": {
        "type": "string",
        "minLength": 1
      },
      "given": {
        "type": "object",
        "minProperties": 1
      },
      "command": {
        "type": "object",
        "minProperties": 1
      },
      "read_back": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "expect": {
        "type": "object",
        "minProperties": 1
      },
      "qualification": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
