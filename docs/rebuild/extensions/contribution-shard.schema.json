{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structural contributions and candidate sites",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "mutation_site"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "source",
          "line",
          "operation"
        ]
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "fixture_field"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "declaration": {
            "type": "object",
            "required": [
              "fieldname",
              "fieldtype"
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "source",
          "target",
          "declaration"
        ]
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "field_literal_candidate"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "declaration": {
            "type": "object",
            "required": [
              "fieldname",
              "fieldtype"
            ],
            "additionalProperties": true
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "source",
          "line",
          "target",
          "declaration"
        ]
      },
      {
        "type": "object",
        "properties": {
          "kind": {
            "const": "fixture_property"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "value_type": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "kind",
          "source",
          "target",
          "field",
          "property",
          "value",
          "value_type"
        ]
      }
    ]
  }
}
