{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "App contribution partition map",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "rows": {
        "type": "integer",
        "minimum": 1
      },
      "counts": {
        "type": "object",
        "properties": {
          "fixture_field": {
            "type": "integer",
            "minimum": 0
          },
          "fixture_property": {
            "type": "integer",
            "minimum": 0
          },
          "mutation_site": {
            "type": "integer",
            "minimum": 0
          },
          "field_literal_candidate": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": []
      },
      "file": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false,
    "required": [
      "rows",
      "counts",
      "file"
    ]
  }
}
