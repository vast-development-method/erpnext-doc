{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Curated app declaration shard",
  "oneOf": [
    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "module": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "child",
              "singleton",
              "virtual",
              "record"
            ]
          },
          "submittable": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "properties": {
                    "reqd": {},
                    "unique": {},
                    "read_only": {},
                    "permlevel": {},
                    "default": {},
                    "precision": {},
                    "allow_on_submit": {},
                    "options": {}
                  },
                  "additionalProperties": false
                }
              ],
              "items": false
            }
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "type": "integer",
                  "minimum": 0
                },
                "rights": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "role",
                "level",
                "rights"
              ]
            }
          }
        },
        "required": [
          "name",
          "source",
          "module",
          "kind",
          "submittable",
          "fields",
          "grants"
        ]
      },
      "minItems": 1
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "enum": [
                    "required",
                    "optional",
                    "variadic-named",
                    "variadic-positional"
                  ]
                }
              ],
              "items": false
            }
          },
          "allow_guest": {
            "type": "boolean"
          },
          "http_methods": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "operation",
          "source",
          "line",
          "parameters",
          "allow_guest"
        ]
      },
      "minItems": 1
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "registration": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "declaration": {},
          "resolution": {
            "const": "computed"
          }
        },
        "required": [
          "registration",
          "source",
          "line"
        ]
      },
      "minItems": 1
    },
    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "record": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "name",
          "source",
          "record",
          "kind",
          "roles"
        ]
      },
      "minItems": 1
    }
  ]
}
