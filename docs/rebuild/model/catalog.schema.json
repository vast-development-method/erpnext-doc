{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned standard record declarations in one module part",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/record"
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "name",
        "source_path",
        "source_blob",
        "kind",
        "properties",
        "grants",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "kind": {
          "enum": [
            "virtual",
            "singleton",
            "child",
            "ordinary"
          ]
        },
        "properties": {
          "type": "object"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "field_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "amend": {
          "enum": [
            0,
            1
          ]
        },
        "cancel": {
          "enum": [
            0,
            1
          ]
        },
        "create": {
          "enum": [
            0,
            1
          ]
        },
        "delete": {
          "enum": [
            0,
            1
          ]
        },
        "email": {
          "enum": [
            0,
            1
          ]
        },
        "export": {
          "enum": [
            0,
            1
          ]
        },
        "if_owner": {
          "enum": [
            0,
            1
          ]
        },
        "import": {
          "enum": [
            0,
            1
          ]
        },
        "permlevel": {
          "type": "integer"
        },
        "print": {
          "enum": [
            0,
            1
          ]
        },
        "read": {
          "enum": [
            0,
            1
          ]
        },
        "report": {
          "enum": [
            0,
            1
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "select": {
          "enum": [
            0,
            1
          ]
        },
        "set_user_permissions": {
          "enum": [
            0,
            1
          ]
        },
        "share": {
          "enum": [
            0,
            1
          ]
        },
        "submit": {
          "enum": [
            0,
            1
          ]
        },
        "write": {
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "type",
        "value_role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "Attach",
            "Attach Image",
            "Autocomplete",
            "Barcode",
            "Button",
            "Check",
            "Code",
            "Color",
            "Column Break",
            "Currency",
            "Data",
            "Date",
            "Datetime",
            "Duration",
            "Dynamic Link",
            "Float",
            "Geolocation",
            "HTML",
            "HTML Editor",
            "Heading",
            "Icon",
            "Image",
            "Int",
            "JSON",
            "Link",
            "Long Text",
            "Markdown Editor",
            "Password",
            "Percent",
            "Read Only",
            "Section Break",
            "Select",
            "Signature",
            "Small Text",
            "Tab Break",
            "Table",
            "Table MultiSelect",
            "Text",
            "Text Editor",
            "Time",
            "Vue Component"
          ]
        },
        "value_role": {
          "enum": [
            "display",
            "child_rows",
            "computed",
            "protected",
            "value"
          ]
        },
        "allow_bulk_edit": {
          "enum": [
            0,
            1
          ]
        },
        "allow_in_quick_entry": {
          "enum": [
            0,
            1
          ]
        },
        "allow_on_submit": {
          "enum": [
            0,
            1
          ]
        },
        "bold": {
          "enum": [
            0,
            1
          ]
        },
        "child_multiselect": {
          "type": "string"
        },
        "children": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collapsible": {
          "enum": [
            0,
            1
          ]
        },
        "collapsible_depends_on": {
          "$ref": "#/$defs/predicate"
        },
        "columns": {
          "type": "integer"
        },
        "default": {
          "type": "string"
        },
        "depends_on": {
          "$ref": "#/$defs/predicate"
        },
        "documentation_url": {
          "type": "string"
        },
        "fetch_from": {
          "type": "string"
        },
        "fetch_if_empty": {
          "enum": [
            0,
            1
          ]
        },
        "hidden": {
          "enum": [
            0,
            1
          ]
        },
        "hide_border": {
          "enum": [
            0,
            1
          ]
        },
        "hide_days": {
          "enum": [
            0,
            1
          ]
        },
        "hide_seconds": {
          "enum": [
            0,
            1
          ]
        },
        "ignore_user_permissions": {
          "enum": [
            0,
            1
          ]
        },
        "ignore_xss_filter": {
          "enum": [
            0,
            1
          ]
        },
        "in_filter": {
          "enum": [
            0,
            1
          ]
        },
        "in_global_search": {
          "enum": [
            0,
            1
          ]
        },
        "in_import_template": {
          "enum": [
            0,
            1
          ]
        },
        "in_list_view": {
          "enum": [
            0,
            1
          ]
        },
        "in_preview": {
          "enum": [
            0,
            1
          ]
        },
        "in_standard_filter": {
          "enum": [
            0,
            1
          ]
        },
        "is_virtual": {
          "enum": [
            0,
            1
          ]
        },
        "label": {
          "type": "string"
        },
        "length": {
          "type": "integer"
        },
        "link_filters": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "mandatory_depends_on": {
          "$ref": "#/$defs/predicate"
        },
        "max_height": {
          "type": "string"
        },
        "max_value": {
          "type": "number"
        },
        "min_value": {
          "type": "number"
        },
        "no_copy": {
          "enum": [
            0,
            1
          ]
        },
        "non_negative": {
          "enum": [
            0,
            1
          ]
        },
        "not_nullable": {
          "enum": [
            0,
            1
          ]
        },
        "options": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "source_presentation_sha256"
              ],
              "properties": {
                "source_presentation_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "permlevel": {
          "type": "integer"
        },
        "placeholder": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "print_hide": {
          "enum": [
            0,
            1
          ]
        },
        "print_hide_if_no_value": {
          "enum": [
            0,
            1
          ]
        },
        "print_width": {
          "type": "string"
        },
        "read_only": {
          "enum": [
            0,
            1
          ]
        },
        "read_only_depends_on": {
          "$ref": "#/$defs/predicate"
        },
        "reference": {
          "type": "string"
        },
        "remember_last_selected_value": {
          "enum": [
            0,
            1
          ]
        },
        "report_hide": {
          "enum": [
            0,
            1
          ]
        },
        "reqd": {
          "enum": [
            0,
            1
          ]
        },
        "search_index": {
          "enum": [
            0,
            1
          ]
        },
        "set_only_once": {
          "enum": [
            0,
            1
          ]
        },
        "show_dashboard": {
          "enum": [
            0,
            1
          ]
        },
        "show_description_on_click": {
          "enum": [
            0,
            1
          ]
        },
        "show_on_timeline": {
          "enum": [
            0,
            1
          ]
        },
        "sort_options": {
          "enum": [
            0,
            1
          ]
        },
        "translatable": {
          "enum": [
            0,
            1
          ]
        },
        "type_selector": {
          "type": "string"
        },
        "unique": {
          "enum": [
            0,
            1
          ]
        },
        "width": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Link"
              }
            }
          },
          "then": {
            "required": [
              "reference"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Dynamic Link"
              }
            }
          },
          "then": {
            "required": [
              "type_selector"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Table"
              }
            }
          },
          "then": {
            "required": [
              "children"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Table MultiSelect"
              }
            }
          },
          "then": {
            "required": [
              "child_multiselect"
            ]
          }
        }
      ]
    },
    "predicate": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "enum": [
            "literal",
            "symbol",
            "field_has_value",
            "form_callback",
            "member",
            "optional_member",
            "not",
            "negate",
            "and",
            "or",
            "coercive_equal",
            "coercive_unequal",
            "strict_equal",
            "strict_unequal",
            "less",
            "greater",
            "at_most",
            "at_least",
            "plus",
            "minus",
            "lambda",
            "subscript",
            "list",
            "call"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "prefixItems": [
              {
                "enum": [
                  "literal"
                ]
              }
            ]
          },
          "then": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [
              {
                "enum": [
                  "literal"
                ]
              },
              {
                "type": [
                  "string",
                  "boolean",
                  "number",
                  "null"
                ]
              }
            ],
            "items": false
          }
        },
        {
          "if": {
            "prefixItems": [
              {
                "enum": [
                  "symbol",
                  "field_has_value",
                  "form_callback"
                ]
              }
            ]
          },
          "then": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [
              {
                "enum": [
                  "symbol",
                  "field_has_value",
                  "form_callback"
                ]
              },
              {
                "type": "string"
              }
            ],
            "items": false
          }
        },
        {
          "if": {
            "prefixItems": [
              {
                "enum": [
                  "member",
                  "optional_member"
                ]
              }
            ]
          },
          "then": {
            "type": "array",
            "minItems": 3,
            "prefixItems": [
              {
                "enum": [
                  "member",
                  "optional_member"
                ]
              },
              {
                "$ref": "#/$defs/predicate"
              },
              {
                "type": "string"
              }
            ],
            "items": false
          }
        },
        {
          "if": {
            "prefixItems": [
              {
                "enum": [
                  "not",
                  "negate"
                ]
              }
            ]
          },
          "then": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [
              {
                "enum": [
                  "not",
                  "negate"
                ]
              },
              {
                "$ref": "#/$defs/predicate"
              }
            ],
            "items": false
          }
        },
        {
          "if": {
            "prefixItems": [
              {
                "enum": [
                  "and",
                  "or",
                  "coercive_equal",
                  "coercive_unequal",
                  "strict_equal",
                  "strict_unequal",
                  "less",
                  "greater",
                  "at_most",
                  "at_least",
                  "plus",
                  "minus",
                  "lambda",
                  "subscript"
                ]
              }
            ]
          },
          "then": {
            "type": "array",
            "minItems": 3,
            "prefixItems": [
              {
                "enum": [
                  "and",
                  "or",
                  "coercive_equal",
                  "coercive_unequal",
                  "strict_equal",
                  "strict_unequal",
                  "less",
                  "greater",
                  "at_most",
                  "at_least",
                  "plus",
                  "minus",
                  "lambda",
                  "subscript"
                ]
              },
              {
                "$ref": "#/$defs/predicate"
              },
              {
                "$ref": "#/$defs/predicate"
              }
            ],
            "items": false
          }
        },
        {
          "if": {
            "prefixItems": [
              {
                "enum": [
                  "list"
                ]
              }
            ]
          },
          "then": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "enum": [
                  "list"
                ]
              }
            ],
            "items": {
              "$ref": "#/$defs/predicate"
            }
          }
        },
        {
          "if": {
            "prefixItems": [
              {
                "enum": [
                  "call"
                ]
              }
            ]
          },
          "then": {
            "type": "array",
            "minItems": 2,
            "prefixItems": [
              {
                "enum": [
                  "call"
                ]
              },
              {
                "$ref": "#/$defs/predicate"
              }
            ],
            "items": {
              "$ref": "#/$defs/predicate"
            }
          }
        }
      ]
    }
  }
}
