{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Six source report projections of the committed FIFO profile",
  "type": "object",
  "properties": {
    "profile": {
      "const": "FIFO-linked-delivery-v1"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "company": {
      "const": "Blueprint Witness"
    },
    "currency": {
      "const": "NAD"
    },
    "fiscal_year": {
      "type": "string",
      "minLength": 1
    },
    "trial_balance": {
      "type": "object",
      "properties": {
        "Debtors - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Witness Bank - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Witness Packed Stock - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Witness Raw Stock - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Witness Input Tax - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Creditors - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Witness Output Tax - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Stock Received But Not Billed - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Capital Stock - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Sales - BWIT": {
          "$ref": "#/$defs/trialRow"
        },
        "Cost of Goods Sold - BWIT": {
          "$ref": "#/$defs/trialRow"
        }
      },
      "required": [
        "Debtors - BWIT",
        "Witness Bank - BWIT",
        "Witness Packed Stock - BWIT",
        "Witness Raw Stock - BWIT",
        "Witness Input Tax - BWIT",
        "Creditors - BWIT",
        "Witness Output Tax - BWIT",
        "Stock Received But Not Billed - BWIT",
        "Capital Stock - BWIT",
        "Sales - BWIT",
        "Cost of Goods Sold - BWIT"
      ],
      "additionalProperties": false
    },
    "balance_sheet": {
      "type": "object",
      "properties": {
        "totals": {
          "type": "object",
          "properties": {
            "Total Asset (Debit)": {
              "$ref": "#/$defs/amount"
            },
            "Total Liability (Credit)": {
              "$ref": "#/$defs/amount"
            },
            "Total Equity (Credit)": {
              "$ref": "#/$defs/amount"
            },
            "Provisional Profit / Loss (Credit)": {
              "$ref": "#/$defs/amount"
            },
            "Total (Credit)": {
              "$ref": "#/$defs/amount"
            }
          },
          "required": [
            "Total Asset (Debit)",
            "Total Liability (Credit)",
            "Total Equity (Credit)",
            "Provisional Profit / Loss (Credit)",
            "Total (Credit)"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "properties": {
            "Total Asset": {
              "$ref": "#/$defs/amount"
            },
            "Total Liability": {
              "$ref": "#/$defs/amount"
            },
            "Total Equity": {
              "$ref": "#/$defs/amount"
            },
            "Provisional Profit / Loss (Credit)": {
              "$ref": "#/$defs/amount"
            }
          },
          "required": [
            "Total Asset",
            "Total Liability",
            "Total Equity",
            "Provisional Profit / Loss (Credit)"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "totals",
        "summary"
      ],
      "additionalProperties": false
    },
    "profit_and_loss": {
      "type": "object",
      "properties": {
        "totals": {
          "type": "object",
          "properties": {
            "Total Income (Credit)": {
              "$ref": "#/$defs/amount"
            },
            "Total Expense (Debit)": {
              "$ref": "#/$defs/amount"
            },
            "Profit for the year": {
              "$ref": "#/$defs/amount"
            }
          },
          "required": [
            "Total Income (Credit)",
            "Total Expense (Debit)",
            "Profit for the year"
          ],
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "properties": {
            "Total Income This Year": {
              "$ref": "#/$defs/amount"
            },
            "Total Expense This Year": {
              "$ref": "#/$defs/amount"
            },
            "Profit This Year": {
              "$ref": "#/$defs/amount"
            }
          },
          "required": [
            "Total Income This Year",
            "Total Expense This Year",
            "Profit This Year"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "totals",
        "summary"
      ],
      "additionalProperties": false
    },
    "open_items": {
      "type": "object",
      "properties": {
        "customer_vouchers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supplier_vouchers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "customer_vouchers",
        "supplier_vouchers"
      ],
      "additionalProperties": false
    },
    "stock_balance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stockRow"
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "profile",
    "fixture_sha256",
    "report_date",
    "company",
    "currency",
    "fiscal_year",
    "trial_balance",
    "balance_sheet",
    "profit_and_loss",
    "open_items",
    "stock_balance"
  ],
  "additionalProperties": false,
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "trialRow": {
      "type": "object",
      "properties": {
        "opening_debit": {
          "$ref": "#/$defs/amount"
        },
        "opening_credit": {
          "$ref": "#/$defs/amount"
        },
        "debit": {
          "$ref": "#/$defs/amount"
        },
        "credit": {
          "$ref": "#/$defs/amount"
        },
        "closing_debit": {
          "$ref": "#/$defs/amount"
        },
        "closing_credit": {
          "$ref": "#/$defs/amount"
        }
      },
      "required": [
        "opening_debit",
        "opening_credit",
        "debit",
        "credit",
        "closing_debit",
        "closing_credit"
      ],
      "additionalProperties": false
    },
    "stockRow": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "warehouse": {
          "type": "string",
          "minLength": 1
        },
        "opening_qty": {
          "$ref": "#/$defs/amount"
        },
        "opening_val": {
          "$ref": "#/$defs/amount"
        },
        "in_qty": {
          "$ref": "#/$defs/amount"
        },
        "in_val": {
          "$ref": "#/$defs/amount"
        },
        "out_qty": {
          "$ref": "#/$defs/amount"
        },
        "out_val": {
          "$ref": "#/$defs/amount"
        },
        "bal_qty": {
          "$ref": "#/$defs/amount"
        },
        "bal_val": {
          "$ref": "#/$defs/amount"
        },
        "val_rate": {
          "$ref": "#/$defs/amount"
        }
      },
      "required": [
        "item",
        "warehouse",
        "opening_qty",
        "opening_val",
        "in_qty",
        "in_val",
        "out_qty",
        "out_val",
        "bal_qty",
        "bal_val",
        "val_rate"
      ],
      "additionalProperties": false
    }
  }
}
