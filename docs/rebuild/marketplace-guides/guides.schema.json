{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multilingual marketplace implementation guide by business area",
  "description": "Each entry joins a dated marketplace row to a detailed profile, attributed public evidence, a documented workflow and a separately identified proposed acceptance case.",
  "type": "array",
  "minItems": 1,
  "$defs": {
    "localizedText": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "af": {
          "type": "string",
          "minLength": 1
        },
        "de": {
          "type": "string",
          "minLength": 1
        },
        "zh-Hans": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "en",
        "af",
        "de",
        "zh-Hans"
      ],
      "additionalProperties": false
    }
  },
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "cohort_position": {
        "type": "integer",
        "minimum": 1,
        "maximum": 69
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "publisher": {
        "type": "string",
        "minLength": 1
      },
      "listed_majors": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "uniqueItems": true
      },
      "profile": {
        "type": "string",
        "pattern": "^apps/[a-z0-9_]+\\.md$"
      },
      "listing": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "listed_repository": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "listed_repository_probe": {
        "const": "http-404"
      },
      "additional_evidence": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "publisher-code",
                "historical-copy",
                "publisher-guide",
                "related-reference"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "task": {
        "$ref": "#/$defs/localizedText"
      },
      "documented_workflow": {
        "$ref": "#/$defs/localizedText"
      },
      "proposed_case": {
        "type": "object",
        "properties": {
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          },
          "language_invariant": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "given",
          "when",
          "then",
          "language_invariant"
        ],
        "additionalProperties": false
      },
      "worked_example": {
        "$ref": "#/$defs/localizedText"
      }
    },
    "required": [
      "id",
      "cohort_position",
      "name",
      "publisher",
      "listed_majors",
      "profile",
      "listing",
      "listed_repository",
      "listed_repository_probe",
      "additional_evidence",
      "task",
      "documented_workflow",
      "proposed_case",
      "worked_example"
    ],
    "additionalProperties": false
  }
}
