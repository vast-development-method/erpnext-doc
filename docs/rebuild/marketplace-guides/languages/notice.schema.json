{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language-specific document delivery acceptance example",
  "type": "object",
  "properties": {
    "kind": {
      "const": "proposed-rebuild-fixture"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "message_key": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "object",
      "properties": {
        "order": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "order"
      ],
      "additionalProperties": false
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "language",
          "revision",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "object",
            "properties": {
              "command": {
                "enum": [
                  "issue",
                  "retry"
                ]
              },
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "view_language": {
                "type": "string",
                "minLength": 1
              },
              "recipient_language": {
                "type": "string",
                "minLength": 1
              },
              "tenant_language": {
                "type": "string",
                "minLength": 1
              },
              "content_class": {
                "enum": [
                  "collection-notice",
                  "agreement"
                ]
              },
              "approved_languages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "command",
              "event_id",
              "view_language",
              "recipient_language",
              "tenant_language",
              "content_class"
            ],
            "additionalProperties": false
          },
          "expect": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "enum": [
                      "sent",
                      "reuse-issued-rendition"
                    ]
                  },
                  "language": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outbox_rows": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "delivery_attempts": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "outcome",
                  "language",
                  "revision",
                  "text",
                  "outbox_rows",
                  "delivery_attempts"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "const": "rejected"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requested_language": {
                    "type": "string",
                    "minLength": 1
                  },
                  "outbox_rows": {
                    "const": 0
                  },
                  "delivery_attempts": {
                    "const": 0
                  }
                },
                "required": [
                  "outcome",
                  "code",
                  "requested_language",
                  "outbox_rows",
                  "delivery_attempts"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "request",
          "expect"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "kind",
    "scope",
    "message_key",
    "arguments",
    "templates",
    "scenarios"
  ],
  "additionalProperties": false
}
