{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock integration test observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["erpnextRevision", "frappeRevision", "cases"],
  "properties": {
    "erpnextRevision": {"const": "886ab6ae187244e7f1b852393384ab6019d56264"},
    "frappeRevision": {"const": "199a0385c00e572664a099a57a00be6ce7404eeb"},
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "class", "method", "source", "execution", "scenario", "assertion", "outcome"],
        "properties": {
          "module": {"type": "string", "pattern": "^erpnext\\.stock\\.doctype\\.[a-z_]+\\.test_[a-z_]+$"},
          "class": {"type": "string", "pattern": "^Test[A-Za-z]+$"},
          "method": {"type": "string", "pattern": "^test_[a-z_]+$"},
          "source": {"type": "string", "pattern": "^https://github\\.com/frappe/erpnext/blob/886ab6ae187244e7f1b852393384ab6019d56264/erpnext/stock/doctype/[a-z_]+/test_[a-z_]+\\.py#L[0-9]+-L[0-9]+$"},
          "execution": {"enum": ["document-workflow", "database-selector", "synchronous-job", "controlled-ordering"]},
          "scenario": {"type": "string", "minLength": 1},
          "assertion": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["passed", "failed", "error", "skipped", "blocked"]}
        }
      }
    }
  }
}
