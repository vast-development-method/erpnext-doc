{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovered September stock controller contracts",
  "type": "object",
  "required": [
    "edition",
    "revision",
    "controller_file_sha256",
    "evidence",
    "contracts"
  ],
  "properties": {
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "const": "4671d1a6658107df592f88f8eb7485847e3d7ae2"
    },
    "controller_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "contracts": {
      "type": "array",
      "minItems": 42,
      "maxItems": 42,
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "name",
          "owner_scope",
          "parameters",
          "scope",
          "source_symbol",
          "source_locations",
          "decision_steps",
          "acceptance_example"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^operation_enterprise_controllers_stock_controller_business_behavior_"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner_scope": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "binding",
                "required"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "binding": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "scope": {
            "const": "current_candidate"
          },
          "source_symbol": {
            "type": "string",
            "minLength": 1
          },
          "source_locations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://github\\.com/frappe/erpnext/blob/4671d1a6658107df592f88f8eb7485847e3d7ae2/[^#]+#L[0-9]+-L[0-9]+$"
            }
          },
          "decision_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_example": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
