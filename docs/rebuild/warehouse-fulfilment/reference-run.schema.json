{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warehouse fulfilment reference observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "erpnextRevision",
    "frappeRevision",
    "date",
    "cases"
  ],
  "properties": {
    "erpnextRevision": {
      "const": "886ab6ae187244e7f1b852393384ab6019d56264"
    },
    "frappeRevision": {
      "const": "199a0385c00e572664a099a57a00be6ce7404eeb"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "method",
          "source",
          "given",
          "expected",
          "outcome"
        ],
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^erpnext\\.stock\\.doctype\\.[a-z_]+\\.test_[a-z_]+$"
          },
          "method": {
            "type": "string",
            "pattern": "^test_[a-z_]+$"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "given": {
            "$ref": "#/$defs/facts"
          },
          "expected": {
            "$ref": "#/$defs/facts"
          },
          "outcome": {
            "const": "passed"
          }
        }
      }
    }
  },
  "$defs": {
    "facts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/value"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/value"
            }
          }
        ]
      }
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    }
  }
}
