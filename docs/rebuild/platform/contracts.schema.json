{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform decision-table catalog",
  "type": "object",
  "required": [
    "revision",
    "contracts"
  ],
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "source",
          "inputSchema",
          "outcomes",
          "rules"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^https://github[.]com/frappe/frappe/blob/[0-9a-f]{40}/"
          },
          "inputSchema": {
            "type": "object",
            "required": [
              "type",
              "required",
              "properties",
              "additionalProperties"
            ],
            "properties": {
              "type": {
                "const": "object"
              },
              "required": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              },
              "properties": {
                "type": "object",
                "minProperties": 1
              },
              "additionalProperties": {
                "const": false
              }
            },
            "additionalProperties": false
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "whenAll",
                "outcome"
              ],
              "properties": {
                "whenAll": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "required": [
                      "field",
                      "op"
                    ],
                    "properties": {
                      "field": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "equal",
                          "less",
                          "atMost",
                          "greater",
                          "atLeast"
                        ]
                      },
                      "value": {
                        "type": [
                          "string",
                          "boolean",
                          "integer"
                        ]
                      },
                      "otherField": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      }
                    },
                    "additionalProperties": false,
                    "oneOf": [
                      {
                        "required": [
                          "value"
                        ]
                      },
                      {
                        "required": [
                          "otherField"
                        ]
                      }
                    ]
                  }
                },
                "outcome": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
