{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational acceptance vector suite",
  "description": "A suite validates the inputs and outputs of each independently named operation. Rules and simplified fixture preconditions are described in README.md.",
  "type": "object",
  "required": [
    "profile",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "erpnext-v16.60.0-operations-1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/forecast.split_whole"
          },
          {
            "$ref": "#/$defs/schedule.remaining_slices"
          },
          {
            "$ref": "#/$defs/schedule.critical_path"
          },
          {
            "$ref": "#/$defs/supplier.score_period"
          },
          {
            "$ref": "#/$defs/supplier.recency_score"
          },
          {
            "$ref": "#/$defs/sourcing.portal_offer"
          },
          {
            "$ref": "#/$defs/inventory.count"
          },
          {
            "$ref": "#/$defs/inventory.close_publish"
          },
          {
            "$ref": "#/$defs/subcontract.allocate"
          },
          {
            "$ref": "#/$defs/subcontract.return_charges"
          },
          {
            "$ref": "#/$defs/quality.review"
          },
          {
            "$ref": "#/$defs/asset.capitalize_fifo"
          },
          {
            "$ref": "#/$defs/reorder.request"
          },
          {
            "$ref": "#/$defs/plan.draft_request"
          }
        ]
      }
    }
  },
