        "operation": {
          "const": "forecast.split_whole"
        },
        "given": {
          "type": "object",
          "properties": {
            "actual": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "forecast": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "actual",
            "forecast"
          ],
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "properties": {
            "shares": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "demand": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "required": [
            "shares",
            "demand"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "operation",
        "given",
        "expect"
      ],
      "additionalProperties": false
    },
