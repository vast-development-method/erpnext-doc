{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Combined procurement site qualification fixture, version 1",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "const": "Purchase Order"
    },
    "data_profile": {
      "type": "object",
      "properties": {
        "frappe": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "erpnext": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": [
        "frappe",
        "erpnext"
      ],
      "additionalProperties": false
    },
    "synthetic_apps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "fixture_files": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/effect"
              },
              "minItems": 0
            },
            "minProperties": 1
          },
          "migrate_customizations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/effect"
            },
            "minItems": 0
          }
        },
        "required": [
          "requires",
          "fixture_files",
          "migrate_customizations"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    },
    "sites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "app_order": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "companies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "actors": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "companies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "roles",
                "companies"
              ],
              "additionalProperties": false
            },
            "minProperties": 1
          },
          "naming_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0
                },
                "when_company": {
                  "type": "string",
                  "minLength": 1
                },
                "prefix": {
                  "type": "string",
                  "minLength": 1
                },
                "digits": {
                  "type": "integer",
                  "minimum": 1
                },
                "counter": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "priority",
                "prefix",
                "digits",
                "counter"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "purchase_orders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "company": {
                  "type": "string",
                  "minLength": 1
                },
                "base_grand_total": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]{2}$"
                },
                "custom_tender_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "owner",
                "company",
                "base_grand_total",
                "custom_tender_ref",
                "state",
                "status"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "app_order",
          "companies",
          "actors",
          "naming_rules",
          "purchase_orders"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    }
  },
  "required": [
    "contract_version",
    "scope",
    "record_type",
    "data_profile",
    "synthetic_apps",
    "sites"
  ],
  "additionalProperties": false,
  "$defs": {
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "custom_field"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "properties": {
                "type": {
                  "const": "Data"
                },
                "insert_after": {
                  "type": "string",
                  "minLength": 1
                },
                "permlevel": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "insert_after",
                "permlevel",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "name",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "property_setter"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "attribute": {
                  "enum": [
                    "label",
                    "permlevel"
                  ]
                },
                "property_type": {
                  "enum": [
                    "Data",
                    "Int"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "field",
                "attribute",
                "property_type",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "name",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "workflow"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "object",
              "properties": {
                "record": {
                  "const": "Purchase Order"
                },
                "state_field": {
                  "type": "string",
                  "minLength": 1
                },
                "states": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "edit_role": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name",
                      "status",
                      "edit_role"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 2
                },
                "transition": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "action": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allow_self": {
                      "type": "boolean"
                    },
                    "condition": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "minLength": 1
                        },
                        "op": {
                          "const": "at_most"
                        },
                        "value": {
                          "type": "string",
                          "pattern": "^[0-9]+\\.[0-9]{2}$"
                        }
                      },
                      "required": [
                        "field",
                        "op",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "from",
                    "action",
                    "to",
                    "role",
                    "allow_self",
                    "condition"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "record",
                "state_field",
                "states",
                "transition"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "name",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "custom_grants"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "read": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "create": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "write": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "submit": {
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "permlevel": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "role"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "name",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
