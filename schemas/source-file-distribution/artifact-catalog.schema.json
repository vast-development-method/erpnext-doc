{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source artifact inventory",
  "type": "object",
  "required": [
    "catalog_kind",
    "source_pack",
    "artifacts"
  ],
  "properties": {
    "catalog_kind": {
      "const": "source_artifact_inventory"
    },
    "source_pack": {
      "enum": [
        "foundation",
        "enterprise",
        "workforce",
        "relationships"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "source_pack",
          "archive_entry_ordinal",
          "content_digest",
          "byte_count",
          "line_count",
          "representation",
          "artifact_role",
          "coverage_scope"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^source-artifact-[a-f0-9]{20}$"
          },
          "archive_entry_ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "line_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "representation": {
            "enum": [
              "unicode_text",
              "binary"
            ]
          }
        }
      }
    }
  }
}
