{
  "title": "Transaction progress and row closure calculations",
  "evidence_level": "source reviewed with independently derived arithmetic cases",
  "reference_execution": "not performed",
  "calculations": [
    {
      "identifier": "transaction_completion_percentage",
      "inputs": [
        "all child rows linked to the target document by parent identity and parent type",
        "expected amount or quantity per row",
        "completed amount or quantity per row"
      ],
      "procedure": [
        "Read every child row of the target document and type. Use the configured reference and completed fields for this transaction.",
        "Sum the absolute reference magnitudes. Return zero for a zero denominator, including an empty result.",
        "For each row take the smaller of its absolute completed and absolute reference magnitudes. Sum these capped magnitudes, divide by the reference sum and multiply by 100.",
        "Round to six decimal places. The status update snaps a percentage of at least 99.999999 to 100."
      ],
      "examples": [
        {
          "expected": [
            "10",
            "10"
          ],
          "completed": [
            "15",
            "0"
          ],
          "percentage": "50.000000"
        },
        {
          "expected": [
            "-10",
            "-10"
          ],
          "completed": [
            "-5",
            "0"
          ],
          "percentage": "25.000000"
        },
        {
          "expected": [
            "0",
            "0"
          ],
          "completed": [
            "0",
            "0"
          ],
          "percentage": "0.000000"
        },
        {
          "expected": [],
          "completed": [],
          "percentage": "0.000000"
        },
        {
          "transaction": "Delivery Note",
          "delivered_quantity": "10",
          "delivery_rate": "10",
          "posted_invoice_quantity": "10",
          "invoice_rate": "8",
          "expected": [
            "100"
          ],
          "completed": [
            "80"
          ],
          "percentage": "80.000000",
          "basis": "Direct invoicing of a nonzero-value delivery uses capped billed amounts."
        },
        {
          "transaction": "zero-base-net linked transaction",
          "expected_quantity": "10",
          "billed_quantity": "10",
          "percentage": "100.000000",
          "basis": "The separate zero-value billing refresh can determine progress from quantities."
        }
      ],
      "specification_links": [
        "../../docs/domains/transaction-progress-and-row-closure.md"
      ],
      "optional_row_closure_policy": {
        "applicability": "extension_policy",
        "inputs": [
          "expected row magnitudes",
          "completed row magnitudes",
          "closed row flags",
          "closure applicability",
          "explicit exclusion filter"
        ],
        "procedure": [
          "Apply explicit row exclusion; return one hundred if that exclusion leaves no rows.",
          "When closure applies, use open rows if any remain; otherwise use all remaining rows.",
          "Take absolute expected and completed values.",
          "Clamp each completed magnitude to its own expected magnitude.",
          "If sum of expected magnitudes is zero, return zero.",
          "Divide sum of clamped magnitudes by sum of expected magnitudes, multiply by one hundred, and round to six decimal places."
        ],
        "examples": [
          {
            "expected": [
              "10",
              "10"
            ],
            "completed": [
              "10",
              "0"
            ],
            "closed": [
              false,
              false
            ],
            "percentage": "50.000000"
          },
          {
            "expected": [
              "10",
              "10"
            ],
            "completed": [
              "10",
              "0"
            ],
            "closed": [
              false,
              true
            ],
            "percentage": "100.000000"
          },
          {
            "expected": [
              "10",
              "10"
            ],
            "completed": [
              "10",
              "0"
            ],
            "closed": [
              true,
              true
            ],
            "percentage": "50.000000"
          },
          {
            "expected": [
              "10",
              "10"
            ],
            "completed": [
              "15",
              "0"
            ],
            "closed": [
              false,
              false
            ],
            "percentage": "50.000000"
          },
          {
            "expected": [
              "-10",
              "-10"
            ],
            "completed": [
              "-5",
              "0"
            ],
            "closed": [
              false,
              false
            ],
            "percentage": "25.000000"
          },
          {
            "expected": [
              "0",
              "0"
            ],
            "completed": [
              "0",
              "0"
            ],
            "closed": [
              false,
              false
            ],
            "percentage": "0.000000"
          },
          {
            "expected": [
              "5"
            ],
            "completed": [
              "0"
            ],
            "closed": [
              false
            ],
            "explicitly_excluded": [
              true
            ],
            "percentage": "100.000000",
            "reason": "Explicit exclusion leaves no calculation rows"
          },
          {
            "expected": [
              "10"
            ],
            "completed": [
              "6"
            ],
            "closed": [
              true
            ],
            "percentage": "60.000000",
            "reason": "All closed falls back to actual performance"
          }
        ]
      },
      "zero_base_net_reference_quantity_refresh": {
        "inputs": [
          "linked non-return invoice quantities",
          "reference quantities"
        ],
        "procedure": [
          "For a qualifying zero-base-net reference, sum the reference quantities and the billed quantities. Cap total billed quantity at the reference quantity.",
          "Divide the capped billed quantity by the reference quantity with safe division. A zero denominator gives zero. Round the ratio to two decimal places using the configured rounding convention, then multiply by 100.",
          "Apply the full-percentage threshold to this result."
        ],
        "examples": [
          {
            "reference_quantity": "3",
            "billed_quantity": "1",
            "rounded_ratio": "0.33",
            "percentage": "33"
          },
          {
            "reference_quantity": "1000",
            "billed_quantity": "996",
            "rounded_ratio": "1.00",
            "percentage": "100"
          }
        ]
      }
    },
    {
      "identifier": "fulfilment_allowance",
      "formula": "overflow percentage = one hundred multiplied by completed minus expected, divided by expected",
      "threshold": "overflow percentage minus allowance exceeds 0.01 percentage points",
      "zero_expected": "percentage check skipped by the calling guard",
      "zero_item_allowance": "falls back to global allowance",
      "override": "configured authorised role receives warning instead of the excess rejection",
      "examples": [
        {
          "expected": "100",
          "completed": "105",
          "allowance_percentage": "5",
          "overflow_percentage": "5",
          "exceeds_threshold": false
        },
        {
          "expected": "100",
          "completed": "105.02",
          "allowance_percentage": "5",
          "overflow_percentage": "5.02",
          "exceeds_threshold": true
        },
        {
          "expected": "100",
          "completed": "105.009",
          "allowance_percentage": "5",
          "overflow_percentage": "5.009",
          "exceeds_threshold": false
        },
        {
          "expected": "100",
          "completed": "105.010",
          "allowance_percentage": "5",
          "overflow_percentage": "5.010",
          "exceeds_threshold": false
        },
        {
          "expected": "100",
          "completed": "105.011",
          "allowance_percentage": "5",
          "overflow_percentage": "5.011",
          "exceeds_threshold": true
        }
      ],
      "specification_links": [
        "../../docs/domains/transaction-progress-and-row-closure.md"
      ]
    },
    {
      "identifier": "absolute_no_allowance_boundary",
      "procedure": [
        "Restrict candidates to completed values greater than expected values",
        "Reject when completed minus expected is strictly greater than 0.01"
      ],
      "examples": [
        {
          "expected": "100",
          "completed": "100.01",
          "rejected": false
        },
        {
          "expected": "100",
          "completed": "100.011",
          "rejected": true
        }
      ],
      "specification_links": [
        "../../docs/domains/transaction-progress-and-row-closure.md#over-fulfilment-and-overbilling"
      ]
    },
    {
      "identifier": "completion_label_boundary",
      "examples": [
        {
          "percentage": "0.000999",
          "common_status": "not completed",
          "zero_value_billing_status": "not billed"
        },
        {
          "percentage": "0.001",
          "common_status": "partly completed",
          "zero_value_billing_status": "partly billed"
        },
        {
          "percentage": "99.999999",
          "common_status": "fully completed",
          "zero_value_billing_status": "fully billed"
        },
        {
          "percentage": "100",
          "common_status": "fully completed",
          "zero_value_billing_status": "fully billed"
        }
      ],
      "specification_links": [
        "../../docs/domains/transaction-progress-and-row-closure.md#parent-percentage-formula"
      ],
      "rules": [
        "Below 0.001 is not completed.",
        "From 0.001 up to 99.999999 is partly completed.",
        "At or above 99.999999 the ordinary and zero-value billing updates snap to 100 and report full completion."
      ]
    },
    {
      "identifier": "closed_order_preserves_posted_effects",
      "given": {
        "ordered_quantity": "10",
        "received_quantity": "6",
        "unit_cost": "12.00",
        "all_rows_closed": true
      },
      "expected": {
        "released_outstanding_commitment": "4",
        "actual_receipt_percentage": "60.000000",
        "warehouse_quantity": "6",
        "received_value": "72.00",
        "parent_status": "Closed",
        "closure_financial_postings": [],
        "closure_physical_stock_movements": []
      },
      "conditional_obligations": [
        "If received units were invoiced, supplier debt remains 72.00 before payment or credit",
        "If received units were unbilled, receipt clearing remains credit 72.00"
      ],
      "specification_links": [
        "../../docs/domains/transaction-progress-and-row-closure.md#financial-and-physical-closure-invariants"
      ],
      "applicability": "optional row-closure policy for released commitments; closing a whole order also preserves already posted stock and accounting records"
    }
  ]
}
