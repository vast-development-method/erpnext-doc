      "name": "Receive cases, deliver six packs and return three packs",
      "case_kind": "numerical_and_state_target",
      "definition_reference": "../../docs/domains/products-units-and-packaging.md",
      "initial_state": {
        "stock_quantity": "0",
        "inventory_value": "0",
        "stock_unit": "Piece",
        "unit_factors": {
          "Pack of Three": "3",
          "Pack of Six": "6",
          "Case of Twelve": "12"
        },
        "valuation_method": "Moving average"
      },
      "operations": [
        {
          "action": "receive",
          "transaction_quantity": "5",
          "unit": "Case of Twelve",
          "transaction_unit_price": "60",
          "expected_stock_change": "60",
          "expected_stock_quantity": "60",
          "expected_inventory_value": "300"
        },
        {
          "action": "deliver",
          "transaction_quantity": "2",
          "unit": "Pack of Six",
          "selling_price_per_transaction_unit": "42",
          "expected_stock_change": "-12",
          "expected_stock_quantity": "48",
          "expected_inventory_value": "240",
          "expected_cost_of_goods_sold": "60",
          "expected_sales_amount": "84"
        },
        {
          "action": "accept_customer_return",
          "transaction_quantity": "1",
          "unit": "Pack of Three",
          "applicable_original_cost_per_piece": "5",
          "expected_stock_change": "3"
        }
      ],
      "expected_final_state": {
        "stock_quantity": "51",
        "inventory_value": "255",
        "net_stock_cost_issued": "45"
      },
      "required_assertions": [
        "No movement uses package dimensions as a unit factor.",
        "Revenue and inventory cost remain independent.",
        "A credit is not inferred from stock cost alone."
      ],
      "verification_status": "Independently checked specification fixture; complete application transaction execution not performed"
