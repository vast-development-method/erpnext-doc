{
  "catalog_name": "Inventory, packaging, fulfilment, manufacturing and quality acceptance cases",
  "catalog_version": "1.0",
  "purpose": "Self-contained replacement-system test inputs and expected business outcomes. Decimal quantities and money are represented by exact decimal strings.",
  "scope_assumptions": [
    "Company currency has two decimal places unless a case overrides it.",
    "Rates retain enough intermediate precision to reproduce rounded stock value.",
    "Quantity units are common within each arithmetic comparison; named pack conversion is applied explicitly.",
    "No tax, discount, exchange difference, allowance or unrelated prior movement exists unless stated.",
    "Cases run independently from their declared initial states.",
    "A described service action is a business operation, not an implementation function.",
    "A concurrency target is a required replacement-system test, not a claim that simultaneous reference execution occurred."
  ],
  "case_count": 29,
