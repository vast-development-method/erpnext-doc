      "verification": "source inspected; example derived independently; runtime not executed",
      "notes": [
        "Each weight share is rounded to two decimal places before multiplication.",
        "Zero denominator yields zero weight share.",
        "Three equal fully completed tasks yield 99 percent, not 100."
      ]
