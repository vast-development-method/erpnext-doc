    {
      "calculation_identifier": "project-weighted-completion",
      "expression": "weight_share = round(task_weight / total_task_weight, 2), or 0 when total_task_weight is zero; completion_percentage = round(sum(task_progress_percentage * weight_share), 2)",
      "inputs": [
        "task_progress_percentages",
        "task_weights"
      ],
      "example": {
        "inputs": {
          "task_progress_percentages": [
            "50",
            "100"
          ],
          "task_weights": [
            "1",
            "3"
          ]
        },
        "expected": {
          "completion_percentage": "87.5"
        }
