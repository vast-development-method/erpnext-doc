    {
      "calculation_identifier": "commercial-product-discount",
      "expression": "product_amount = quantity * rate; discount_amount = product_amount * discount_percentage / 100; net_amount = product_amount - discount_amount",
      "inputs": [
        "quantity",
        "rate",
        "discount_percentage"
      ],
      "example": {
        "inputs": {
          "quantity": "12",
          "rate": "25",
          "discount_percentage": "10"
        },
        "expected": {
          "product_amount": "300",
          "discount_amount": "30",
          "net_amount": "270"
        }
      },
      "evidence": [
        {
          "source_artifact_identifier": "source-artifact-9dbe99a3c18eb4acc088",
          "first_line": 108,
          "last_line": 193
