{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exposed operation inventory",
  "type": "object",
  "required": [
    "catalog_kind",
    "source_pack",
    "operations"
  ],
  "properties": {
    "catalog_kind": {
      "const": "exposed_operation_inventory"
    },
    "source_pack": {
      "enum": [
        "foundation",
        "enterprise",
        "workforce",
        "relationships"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "name",
          "source_artifact",
          "line_start",
          "line_end",
          "parameters",
          "anonymous_registration",
          "transport_verbs",
          "contract_status"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^source-operation-[a-f0-9]{20}$"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "binding",
                "required"
              ]
            }
          },
          "transport_verbs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
