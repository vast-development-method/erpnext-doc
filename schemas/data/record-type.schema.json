{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record type specification",
  "type": "object",
  "required": [
    "catalog_kind",
    "identifier",
    "name",
    "source_artifact",
    "persistence_kind",
    "fields",
    "field_count",
    "ordered_field_names",
    "declared_permission_grants"
  ],
  "properties": {
    "catalog_kind": {
      "const": "record_type_specification"
    },
    "identifier": {
      "type": "string",
      "pattern": "^record_type_[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "source_artifact": {
      "type": "string",
      "pattern": "^source-artifact-[a-f0-9]{20}$"
    },
    "persistence_kind": {
      "enum": [
        "virtual_record",
        "singleton_settings",
        "owned_child_record",
        "independent_record"
      ]
    },
    "field_count": {
      "type": "integer",
      "minimum": 0
    },
    "ordered_field_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "name",
          "source_field_ordinal",
          "value_type",
          "persistence",
          "properties"
        ],
        "properties": {
          "source_field_ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "persistence": {
            "enum": [
              "presentation_only",
              "virtual_computed_value",
              "owned_child_records",
              "protected_secret_storage",
              "persistent_scalar"
            ]
          },
          "properties": {
            "type": "object"
          }
        }
      }
    },
    "declared_permission_grants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
