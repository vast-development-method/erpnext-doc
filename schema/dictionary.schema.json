{
  "title": "Business entity dictionary",
  "description": "A business area or ordered segment of an area. Shared attributes and relationship cardinalities are defined in the relational design guide.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/entity"
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "entity",
        "kind",
        "grants",
        "fields"
      ],
      "properties": {
        "entity": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "kind": {
          "enum": [
            "computed_record",
            "independent_record",
            "owned_row",
            "singleton_settings"
          ]
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "presentation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          }
        },
        "hierarchy_parent": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "maximum_attachments": {
          "type": "integer"
        },
        "posting_lifecycle": {
          "type": "boolean"
        },
        "renaming_permitted": {
          "type": "boolean"
        },
        "import_supported": {
          "type": "boolean"
        },
        "scheduling_supported": {
          "type": "boolean"
        },
        "audit_changes": {
          "type": "boolean"
        },
        "form_read_only": {
          "type": "boolean"
        },
        "compatibility_only": {
          "type": "boolean",
          "description": "Retained to interpret existing data from an earlier layout. Excluded from active entry, validation and posting."
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "field",
        "type"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "barcode",
            "boolean",
            "calendar_date",
            "color",
            "date_and_time",
            "decimal",
            "display_value",
            "duration",
            "entity_reference",
            "enumeration",
            "expression_or_structured_text",
            "file_reference",
            "formatted_markup",
            "formatted_text",
            "geographic_geometry",
            "icon",
            "image_file_reference",
            "integer",
            "long_text",
            "monetary_amount",
            "owned_collection",
            "owned_selection",
            "percentage",
            "protected_value",
            "rating",
            "selected_entity_reference",
            "short_text",
            "signature",
            "structured_value",
            "suggested_text",
            "telephone_number",
            "text",
            "time_of_day"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "line_identity_in": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "target_selected_by": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "currency": {
          "type": "object"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default": {},
        "copy_from": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "minItems": 1
        },
        "selection_filter": {},
        "required": {
          "type": "boolean"
        },
        "form_read_only": {
          "type": "boolean"
        },
        "form_hidden": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "nonnegative": {
          "type": "boolean"
        },
        "write_once": {
          "type": "boolean"
        },
        "nonnullable": {
          "type": "boolean"
        },
        "omit_on_copy": {
          "type": "boolean"
        },
        "editable_after_posting": {
          "type": "boolean"
        },
        "searchable": {
          "type": "boolean"
        },
        "omit_target_user_filter": {
          "type": "boolean"
        },
        "translatable": {
          "type": "boolean"
        },
        "computed": {
          "type": "boolean"
        },
        "copy_only_when_empty": {
          "type": "boolean"
        },
        "minimum": {
          "type": [
            "integer",
            "number",
            "string"
          ]
        },
        "maximum": {
          "type": [
            "integer",
            "number",
            "string"
          ]
        },
        "maximum_length": {
          "type": [
            "integer",
            "number",
            "string"
          ]
        },
        "precision": {
          "type": [
            "integer",
            "number",
            "string"
          ]
        },
        "access_level": {
          "type": [
            "integer",
            "number",
            "string"
          ]
        },
        "visible_when": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "prefixItems": [
                {
                  "type": "string"
                }
              ]
            },
            {
              "type": "object",
              "required": [
                "decision",
                "examples"
              ]
            }
          ]
        },
        "read_only_when": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "prefixItems": [
                {
                  "type": "string"
                }
              ]
            },
            {
              "type": "object",
              "required": [
                "decision",
                "examples"
              ]
            }
          ]
        },
        "required_when": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "prefixItems": [
                {
                  "type": "string"
                }
              ]
            },
            {
              "type": "object",
              "required": [
                "decision",
                "examples"
              ]
            }
          ]
        },
        "compatibility_only": {
          "type": "boolean",
          "description": "Retained to interpret existing data from an earlier layout. Excluded from active entry, validation and posting."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "entity_reference",
                  "owned_selection",
                  "owned_collection"
                ]
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "selected_entity_reference"
              }
            }
          },
          "then": {
            "required": [
              "target_selected_by"
            ]
          }
        }
      ]
    },
    "grant": {
      "type": "object",
      "required": [
        "role",
        "level",
        "allows"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "level": {
          "type": "integer",
          "minimum": 0
        },
        "owner_only": {
          "type": "boolean"
        },
        "allows": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": [
        "control"
      ],
      "properties": {
        "control": {
          "enum": [
            "section",
            "tab",
            "action",
            "interactive_control",
            "display_image",
            "formatted_information",
            "heading"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "visible_when": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "prefixItems": [
                {
                  "type": "string"
                }
              ]
            },
            {
              "type": "object",
              "required": [
                "decision",
                "examples"
              ]
            }
          ]
        },
        "expanded_when": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "prefixItems": [
                {
                  "type": "string"
                }
              ]
            },
            {
              "type": "object",
              "required": [
                "decision",
                "examples"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
