  {
    "entity": "automation.auto_repeat",
    "kind": "independent_record",
    "renaming_permitted": true,
    "import_supported": true,
    "audit_changes": true,
    "grants": [
      {"role": "system_manager", "level": 0, "allows": ["create", "delete", "email", "export", "print", "read", "report", "share", "write"]},
      {"role": "accounts_manager", "level": 0, "allows": ["create", "delete", "email", "export", "print", "read", "report", "share", "write"]},
      {"role": "accounts_user", "level": 0, "allows": ["create", "delete", "email", "export", "print", "read", "report", "share", "write"]}
    ],
    "fields": [
      {"field": "reference_entity_type_identifier", "type": "entity_reference", "target": "information_management.entity_type", "required": true},
      {"field": "reference_document_identifier", "type": "selected_entity_reference", "target_selected_by": "reference_entity_type_identifier", "required": true, "omit_on_copy": true},
      {"field": "start_date", "type": "calendar_date", "required": true, "default": {"context_default": "effective_date"}},
      {"field": "end_date", "type": "calendar_date"},
      {"field": "disabled", "type": "boolean", "omit_on_copy": true, "default": "0"},
      {"field": "frequency", "type": "enumeration", "required": true, "values": ["", "Daily", "Weekly", "Fortnightly", "Monthly", "Quarterly", "Half-yearly", "Yearly"]},
      {"field": "repeat_on_day", "type": "integer", "visible_when": ["and", ["call", ["context", "contains_value"], ["list", ["literal", "Monthly"], ["literal", "Quarterly"], ["literal", "Half-yearly"], ["literal", "Yearly"]], ["current_field", "frequency"]], ["not", ["current_field", "repeat_on_last_day"]]]},
      {"field": "next_schedule_date", "type": "calendar_date", "form_read_only": true, "omit_on_copy": true, "searchable": true},
      {"field": "notify_by_email", "type": "boolean", "default": "0"},
      {"field": "recipients", "type": "text", "visible_when": ["field_has_value", "notify_by_email"]},
      {"field": "template_identifier", "type": "entity_reference", "target": "mail.email_template", "visible_when": ["current_field", "notify_by_email"]},
      {"field": "subject", "type": "short_text", "visible_when": ["current_field", "notify_by_email"]},
      {"field": "message", "type": "text", "default": "Attachment notice including entity type and record identifier", "visible_when": ["current_field", "notify_by_email"]},
      {"field": "print_format_identifier", "type": "entity_reference", "target": "document_output.print_format", "visible_when": ["field_has_value", "notify_by_email"]},
      {"field": "status", "type": "enumeration", "form_read_only": true, "form_hidden": true, "values": ["", "Active", "Disabled", "Completed"]},
      {"field": "repeat_on_last_day", "type": "boolean", "default": "0", "visible_when": ["strict_equal", ["current_field", "frequency"], ["literal", "Monthly"]]},
      {"field": "repeat_on_days_rows", "type": "owned_collection", "target": "automation.auto_repeat_day", "visible_when": ["strict_equal", ["current_field", "frequency"], ["literal", "Weekly"]]},
      {"field": "submit_on_creation", "type": "boolean", "default": "0"},
      {"field": "generate_separate_documents_for_each_assignee", "type": "boolean", "default": "0"},
      {"field": "assignee_rows", "type": "owned_selection", "target": "automation.auto_repeat_user"}
    ],
    "presentation": [
      {"control": "tab", "purpose": "Schedule"},
      {"control": "tab", "purpose": "Notification"},
      {"control": "action", "purpose": "Get Contacts", "visible_when": ["and", ["and", ["current_field", "notify_by_email"], ["current_field", "reference_entity_type_identifier"]], ["current_field", "reference_document_identifier"]]},
      {"control": "action", "purpose": "Preview Message", "visible_when": ["and", ["and", ["current_field", "notify_by_email"], ["current_field", "reference_entity_type_identifier"]], ["current_field", "reference_document_identifier"]]},
      {"control": "section", "visible_when": ["strict_equal", ["current_field", "frequency"], ["literal", "Weekly"]]}
    ]
  },
