[
  {
    "entity": "automation.assignment_rule",
    "kind": "independent_record",
    "renaming_permitted": true,
    "audit_changes": true,
    "grants": [
      {"role": "system_manager", "level": 0, "allows": ["create", "delete", "email", "export", "print", "read", "report", "share", "write"]}
    ],
    "fields": [
      {"field": "document_type_identifier", "type": "entity_reference", "target": "information_management.entity_type", "required": true},
      {"field": "priority", "type": "integer"},
      {"field": "disabled", "type": "boolean", "default": "0"},
      {"field": "description", "type": "text", "required": true, "default": "Automatic Assignment"},
      {"field": "assign_condition", "type": "expression_or_structured_text", "required": true},
      {"field": "unassign_condition", "type": "expression_or_structured_text"},
      {"field": "rule", "type": "enumeration", "required": true, "values": ["Round Robin", "Load Balancing", "Based on Field", "Weighted Distribution"]},
      {"field": "users_rows", "type": "owned_selection", "target": "automation.assignment_rule_user", "visible_when": ["call", ["context", "contains_value"], ["list", ["literal", "Round Robin"], ["literal", "Load Balancing"]], ["current_field", "rule"]], "required_when": ["call", ["context", "contains_value"], ["list", ["literal", "Round Robin"], ["literal", "Load Balancing"]], ["current_field", "rule"]]},
      {"field": "last_user_identifier", "type": "entity_reference", "target": "information_management.user", "form_read_only": true},
      {"field": "close_condition", "type": "expression_or_structured_text"},
      {"field": "assignment_days_rows", "type": "owned_collection", "target": "automation.assignment_rule_day", "required": true},
      {"field": "due_date_based_on", "type": "enumeration", "visible_when": ["field_has_value", "document_type_identifier"]},
      {"field": "assignee_selection_field", "type": "enumeration", "visible_when": ["coercive_equal", ["current_field", "rule"], ["literal", "Based on Field"]], "required_when": ["coercive_equal", ["current_field", "rule"], ["literal", "Based on Field"]]},
      {"field": "current_index", "type": "integer", "form_read_only": true, "visible_when": ["coercive_equal", ["current_field", "rule"], ["literal", "Weighted Distribution"]]},
      {"field": "weighted_users_rows", "type": "owned_collection", "target": "automation.assignment_rule_user", "visible_when": ["coercive_equal", ["current_field", "rule"], ["literal", "Weighted Distribution"]], "required_when": ["coercive_equal", ["current_field", "rule"], ["literal", "Weighted Distribution"]]}
    ],
    "presentation": [
      {"control": "section", "purpose": "Assignment Rules"},
      {"control": "section", "purpose": "Assign To Users"},
      {"control": "section", "purpose": "Assignment Days"}
    ]
  },
