  {
    "entity": "administration.video",
    "kind": "independent_record",
    "renaming_permitted": true,
    "import_supported": true,
    "audit_changes": true,
    "grants": [
      {"role": "desk_user", "level": 0, "owner_only": true, "allows": ["create", "delete", "email", "export", "print", "read", "report", "share", "write"]},
      {"role": "system_manager", "level": 0, "allows": ["create", "delete", "email", "export", "print", "read", "report", "share", "write"]}
    ],
    "fields": [
      {"field": "title", "type": "short_text", "required": true, "unique": true},
      {"field": "provider", "type": "enumeration", "required": true, "values": ["video hosting service", "Vimeo"]},
      {"field": "resource_address", "type": "short_text", "required": true},
      {"field": "publish_date", "type": "calendar_date"},
      {"field": "duration", "type": "duration"},
      {"field": "description", "type": "formatted_text", "required": true},
      {"field": "like_count", "type": "decimal", "form_read_only": true, "omit_on_copy": true},
      {"field": "view_count", "type": "decimal", "form_read_only": true, "omit_on_copy": true},
      {"field": "dislike_count", "type": "decimal", "form_read_only": true, "omit_on_copy": true},
      {"field": "comment_count", "type": "decimal", "form_read_only": true, "omit_on_copy": true},
      {"field": "image", "type": "image_file_reference", "form_hidden": true, "omit_on_copy": true},
      {"field": "youtube_video_identifier", "type": "short_text", "form_read_only": true, "form_hidden": true}
    ],
    "presentation": [
      {"control": "section", "purpose": "video hosting service Statistics", "visible_when": ["coercive_equal", ["current_field", "provider"], ["literal", "video hosting service"]]}
    ]
  },
  {
    "entity": "administration.video_settings",
    "kind": "singleton_settings",
    "audit_changes": true,
    "grants": [
      {"role": "system_manager", "level": 0, "allows": ["create", "delete", "email", "print", "read", "share", "write"]}
    ],
    "fields": [
      {"field": "enable_youtube_tracking", "type": "boolean", "default": "0"},
      {"field": "service_interface_key", "type": "short_text", "visible_when": ["current_field", "enable_youtube_tracking"], "required_when": ["current_field", "enable_youtube_tracking"]},
      {"field": "frequency", "type": "enumeration", "values": ["1 hr", "6 hrs", "Daily"], "default": "1 hr", "visible_when": ["current_field", "enable_youtube_tracking"], "required_when": ["current_field", "enable_youtube_tracking"]},
      {"field": "last_youtube_update", "type": "date_and_time", "form_read_only": true, "form_hidden": true}
    ]
  }
]
