  {
    "entity": "administration.rename_tool",
    "kind": "singleton_settings",
    "maximum_attachments": 1,
    "grants": [
      {"role": "system_manager", "level": 0, "allows": ["create", "read", "share", "write"]}
    ],
    "fields": [
      {"field": "select_entity_type_identifier", "type": "entity_reference", "target": "information_management.entity_type", "selection_filter": [["information_management.entity_type", "allow_rename", "=", 1], ["information_management.entity_type", "module_identifier", "!=", "Core"]]},
      {"field": "file_to_rename", "type": "file_reference"}
    ],
    "presentation": [
      {"control": "formatted_information", "purpose": "Rename Log"}
    ]
