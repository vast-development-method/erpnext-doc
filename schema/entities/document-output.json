    "presentation": [
      {"control": "section", "purpose": "PDF Settings"},
      {"control": "section", "purpose": "Page Settings"},
      {"control": "section", "purpose": "Print Server"},
      {"control": "section", "purpose": "Raw Printing"},
      {"control": "section", "purpose": "Print Style"},
      {"control": "formatted_information", "purpose": "Print Style Preview"},
