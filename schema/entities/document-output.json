      {"field": "portable_document_page_width", "type": "decimal", "visible_when": ["coercive_equal", ["current_field", "portable_document_page_size"], ["literal", "Custom"]]},
      {"field": "portable_document_generator", "type": "enumeration", "values": ["document layout engine", "browser layout engine", "paged layout engine"], "default": "browser layout engine"},
      {"field": "maximum_bulk_print_records", "type": "integer", "nonnegative": true, "default": "100"},
      {"field": "maximum_concurrent_bulk_exports", "type": "integer", "nonnegative": true, "default": "5"}
