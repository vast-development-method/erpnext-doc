[
  {
    "entity": "business_integrations.bank_account_aggregation_settings",
    "kind": "singleton_settings",
    "audit_changes": true,
    "grants": [
      {"role": "system_manager", "level": 0, "allows": ["create", "delete", "email", "print", "read", "share", "write"]}
    ],
    "fields": [
      {"field": "enabled", "type": "boolean", "default": "0"},
      {"field": "automatic_sync", "type": "boolean", "default": "0", "visible_when": ["field_has_value", "enabled"]},
      {"field": "bank_account_aggregation_client_identifier", "type": "short_text"},
      {"field": "bank_account_aggregation_secret", "type": "protected_value"},
      {"field": "bank_account_aggregation_env", "type": "enumeration", "values": ["sandbox", "development", "production"]},
      {"field": "enable_european_access", "type": "boolean", "default": "0"}
    ],
    "presentation": [
      {"control": "section", "visible_when": ["field_has_value", "enabled"]}
    ]
  }
]
