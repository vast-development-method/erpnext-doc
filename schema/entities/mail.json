      {"field": "service_interface_key", "type": "short_text", "visible_when": ["and", ["coercive_equal", ["current_field", "service"], ["literal", "Integrated mail"]], ["coercive_equal", ["current_field", "authentication_method"], ["literal", "Basic"]]], "required_when": ["and", ["coercive_equal", ["current_field", "service"], ["literal", "Integrated mail"]], ["coercive_equal", ["current_field", "authentication_method"], ["literal", "Basic"]]]},
