{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exposed operation inventory",
  "type": "object",
  "required": [
    "catalog_kind",
    "capability_group",
    "operations"
  ],
  "properties": {
    "catalog_kind": {
      "const": "exposed_operation_inventory"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "name",
          "parameters",
          "anonymous_registration",
          "transport_verbs",
          "contract_status",
          "procedure_identifier",
          "request_binding_contract"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "binding",
                "required"
              ]
            }
          },
          "transport_verbs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "procedure_identifier": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capability_group": {
      "enum": [
        "foundation",
        "enterprise",
        "workforce",
        "relationships"
      ]
    }
  }
}
