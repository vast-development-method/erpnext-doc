{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application component catalog",
  "type": "object",
  "required": [
    "catalog_kind",
    "components"
  ],
  "properties": {
    "catalog_kind": {
      "const": "component_contracts"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "name",
          "classification",
          "scope",
          "role_description"
        ],
        "properties": {
          "identifier": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "role_description": {
            "type": "string"
          }
        }
      }
    }
  }
}
